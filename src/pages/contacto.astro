---
import Layout from '../layouts/Layout.astro';
import CatIllustration from '../components/ui/CatIllustration.astro';
---

<Layout
  title="Contacto & Acceso | meowlab"
  description="Habla con nosotros o prueba los asistentes de MeowLab en WhatsApp para tu negocio."
>
  <div class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Left Column: Form & Info -->
        <div class="lg:col-span-7 space-y-8">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-mint/50 text-brand-forest text-xs font-medium mb-3">
              <span>Estamos para ayudarte</span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-content-main tracking-tight leading-[1.15]">
              Empieza a avanzar con MeowLab
            </h1>
            <p class="text-content-secondary text-base sm:text-lg mt-3 leading-relaxed">
              Cuéntanos qué tareas te quitan más tiempo y te mostraremos cómo resolverlas directo desde tu WhatsApp.
            </p>
          </div>

          <!-- Contact Form -->
          <form id="contact-form" class="bg-white p-6 sm:p-8 rounded-3xl border border-surface-border space-y-5 shadow-soft">
            <div class="grid sm:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label class="text-xs font-medium text-content-secondary">Tu Nombre *</label>
                <input
                  type="text"
                  required
                  placeholder="Ej. Andrés Morales"
                  class="w-full bg-surface-subtle border border-surface-border rounded-xl px-4 py-3 text-sm text-content-main placeholder:text-content-muted focus:outline-none focus:border-brand-forest focus:bg-white transition-colors"
                />
              </div>
              <div class="space-y-1.5">
                <label class="text-xs font-medium text-content-secondary">Empresa o Negocio *</label>
                <input
                  type="text"
                  required
                  placeholder="Ej. Distribuidora San José"
                  class="w-full bg-surface-subtle border border-surface-border rounded-xl px-4 py-3 text-sm text-content-main placeholder:text-content-muted focus:outline-none focus:border-brand-forest focus:bg-white transition-colors"
                />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div class="space-y-1.5">
                <label class="text-xs font-medium text-content-secondary">WhatsApp o Teléfono *</label>
                <input
                  type="tel"
                  required
                  placeholder="Ej. +51 987 654 321"
                  class="w-full bg-surface-subtle border border-surface-border rounded-xl px-4 py-3 text-sm text-content-main placeholder:text-content-muted focus:outline-none focus:border-brand-forest focus:bg-white transition-colors"
                />
              </div>
              <div class="space-y-1.5">
                <label class="text-xs font-medium text-content-secondary">Correo Electrónico *</label>
                <input
                  type="email"
                  required
                  placeholder="andres@tuempresa.com"
                  class="w-full bg-surface-subtle border border-surface-border rounded-xl px-4 py-3 text-sm text-content-main placeholder:text-content-muted focus:outline-none focus:border-brand-forest focus:bg-white transition-colors"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label class="text-xs font-medium text-content-secondary">¿Qué tarea necesitas resolver primero? *</label>
              <select class="w-full bg-surface-subtle border border-surface-border rounded-xl px-4 py-3 text-sm text-content-main focus:outline-none focus:border-brand-forest focus:bg-white transition-colors">
                <option value="licitaciones">Búsqueda de licitaciones y compras del Estado</option>
                <option value="facturas">Emisión rápida de facturas y boletas</option>
                <option value="tramites">Seguimiento de trámites y documentos</option>
                <option value="erp">Consultas de precios, stock o ventas</option>
                <option value="custom">Asistente personalizado a tu medida</option>
              </select>
            </div>

            <div class="space-y-1.5">
              <label class="text-xs font-medium text-content-secondary">Detalles adicionales (opcional)</label>
              <textarea
                rows="3"
                placeholder="Cuéntanos qué vendes o qué te gustaría resolver en tu día a día..."
                class="w-full bg-surface-subtle border border-surface-border rounded-xl p-4 text-sm text-content-main placeholder:text-content-muted focus:outline-none focus:border-brand-forest focus:bg-white transition-colors"
              ></textarea>
            </div>

            <button type="submit" class="btn-primary w-full py-4 rounded-xl text-base font-medium">
              Solicitar información
            </button>
          </form>

          <div id="form-success" class="hidden p-6 rounded-2xl bg-brand-mint-light border border-brand-mint text-center text-brand-forest font-medium">
            ¡Listo! Recibimos tu mensaje. Te escribiremos por WhatsApp para ayudarte a configurar tu asistente.
          </div>
        </div>

        <!-- Right Column: Direct Contact & Guarantees -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-surface-subtle border border-surface-border p-8 rounded-3xl text-center space-y-6 shadow-soft">
            <div class="flex justify-center">
              <CatIllustration variant="laptop" size={90} />
            </div>

            <div>
              <h3 class="text-xl font-bold text-content-main">Acompañamiento y Soporte</h3>
              <p class="text-xs text-content-secondary mt-1">Te ayudamos a dejar todo listo para que empieces a usar tu asistente en minutos.</p>
            </div>

            <div class="border-t border-surface-border pt-4 space-y-3 text-left text-xs text-content-secondary">
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-brand-forest"></span>
                <span>Configuración rápida en menos de 24 horas</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-brand-forest"></span>
                <span>Funciona en cualquier celular con WhatsApp</span>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="w-2 h-2 rounded-full bg-brand-forest"></span>
                <span>Tus datos y conversaciones siempre protegidos</span>
              </div>
            </div>

            <a
              href="https://wa.me/51987654321?text=Hola%20MeowLab,%20quiero%20conocer%20mas%20sobre%20los%20asistentes."
              target="_blank"
              class="btn-secondary w-full py-3.5 rounded-xl font-medium text-sm"
            >
              Consultar por WhatsApp ↗
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form');
    const successMsg = document.getElementById('form-success');
    if (form && successMsg) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.classList.add('hidden');
        successMsg.classList.remove('hidden');
      });
    }
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
