---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const comparisonRows = [
  {
    feature: 'Canal de operación',
    roleAgent: 'Número compartido o corporativo en WhatsApp',
    dedicated: 'Número WhatsApp Business exclusivo verificado'
  },
  {
    feature: 'Conexión a base de datos',
    roleAgent: 'Esquema estándar gestionado por MeowLab',
    dedicated: 'Conexión directa a tu PostgreSQL, SQL Server o SAP'
  },
  {
    feature: 'Infraestructura y red',
    roleAgent: 'Nube multitenant con aislamiento lógico',
    dedicated: 'VPC privada, túnel VPN o despliegue on-premise'
  },
  {
    feature: 'Reglas de aprobación',
    roleAgent: 'Flujos preconfigurados por especialidad',
    dedicated: 'Flujos, roles y permisos hechos a medida'
  },
  {
    feature: 'Tiempo de puesta en marcha',
    roleAgent: 'Activación el mismo día',
    dedicated: 'Implementación guiada en 5 a 10 días hábiles'
  }
];

const implementationSteps = [
  {
    number: 'Paso 1',
    title: 'Diagnóstico',
    timeline: 'Días 1–2',
    description: 'Revisamos tus esquemas de base de datos, endpoints de API, permisos por rol y las consultas críticas que tu equipo necesita resolver desde WhatsApp.'
  },
  {
    number: 'Paso 2',
    title: 'Conexión',
    timeline: 'Días 3–5',
    description: 'Configuramos conectores seguros de solo lectura o escritura controlada mediante túnel VPN o lista blanca de IPs hacia tu infraestructura.'
  },
  {
    number: 'Paso 3',
    title: 'Entrenamiento',
    timeline: 'Días 6–8',
    description: 'Definimos validaciones deterministas, diccionarios de negocio y pruebas en ambiente de staging con casos reales de tu operación.'
  },
  {
    number: 'Paso 4',
    title: 'Despliegue',
    timeline: 'Días 9–10',
    description: 'Activamos el asistente en tu línea corporativa de WhatsApp con control de acceso por número telefónico y monitoreo operativo.'
  }
];
---

<Layout
  title="Solución Dedicada de IA para Empresas | MeowLab"
  description="Conecta un asistente exclusivo a tus bases de datos privadas (PostgreSQL, SAP, ERP) a través de WhatsApp corporativo con control de acceso y auditoría."
>
  <div class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      <!-- Hero Section (no eyebrow pill per #rule-hero-eyebrow-chip) -->
      <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <div class="lg:col-span-7 space-y-6">
          <h1 class="text-3xl sm:text-5xl font-bold text-content-main tracking-tight leading-[1.12] text-balance">
            Tu sistema y ERP <span class="text-brand-forest">desde WhatsApp</span>
          </h1>
          <p class="text-content-muted text-base sm:text-lg leading-relaxed">
            Sin paneles complejos ni demoras operativas. Tus ejecutivos, supervisores y equipo comercial consultan stock, saldos de clientes y estado de despachos en tiempo real desde WhatsApp, bajo permisos estrictos conectados a tu propia infraestructura.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="/contacto"
              class="bg-brand-forest text-white hover:bg-brand-forestDark px-6 py-3.5 rounded-xl font-title font-bold text-sm sm:text-base inline-flex items-center gap-2 transition-colors"
            >
              <span>Agendar sesión de arquitectura técnica</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
            <a
              href="/agentes"
              class="bg-surface-subtle text-content-main hover:bg-surface-mint/50 px-6 py-3.5 rounded-xl font-title font-bold text-sm sm:text-base inline-flex items-center transition-colors"
            >
              <span>Ver catálogo de especialistas</span>
            </a>
          </div>

          <!-- Key Technical Guarantees Row -->
          <div class="pt-6 grid sm:grid-cols-3 gap-6">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2 text-brand-forest font-title font-bold text-sm">
                <!-- TablerIcon: database -->
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 6m-8 0a8 3 0 1 0 16 0a8 3 0 1 0 -16 0" />
                  <path d="M4 6v6a8 3 0 0 0 16 0v-6" />
                  <path d="M4 12v6a8 3 0 0 0 16 0v-6" />
                </svg>
                <span>Bases de datos SQL</span>
              </div>
              <p class="text-sm text-content-muted leading-relaxed">
                Consultas parametrizadas sobre PostgreSQL, MySQL, SQL Server u Oracle con permisos acotados.
              </p>
            </div>

            <div class="space-y-1.5">
              <div class="flex items-center gap-2 text-brand-forest font-title font-bold text-sm">
                <!-- TablerIcon: settings -->
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" />
                  <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                </svg>
                <span>Integración ERP / API</span>
              </div>
              <p class="text-sm text-content-muted leading-relaxed">
                Conectores con SAP Business One, Odoo, NetSuite y servicios REST internos de tu empresa.
              </p>
            </div>

            <div class="space-y-1.5">
              <div class="flex items-center gap-2 text-brand-forest font-title font-bold text-sm">
                <!-- TablerIcon: lock -->
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z" />
                  <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0" />
                  <path d="M8 11v-4a4 4 0 1 1 8 0v4" />
                </svg>
                <span>Aislamiento y auditoría</span>
              </div>
              <p class="text-sm text-content-muted leading-relaxed">
                Tus datos nunca entrenan modelos públicos; cada consulta valida identidad y queda registrada.
              </p>
            </div>
          </div>
        </div>

        <!-- Architecture Diagram Panel -->
        <aside data-ui class="lg:col-span-5 bg-surface-subtle rounded-2xl p-6 sm:p-8">
          <div class="flex items-center justify-between pb-4 mb-2">
            <div>
              <div class="text-base font-title font-bold text-content-main">Arquitectura dedicada</div>
              <p class="text-sm text-content-muted">Flujo seguro de extremo a extremo</p>
            </div>
            <span class="text-sm font-semibold px-2.5 py-1 rounded-md bg-surface-mint text-brand-forest">
              VPC / VPN
            </span>
          </div>

          <div class="space-y-4">
            <div class="bg-white rounded-xl p-4 flex items-start gap-3.5">
              <div class="w-9 h-9 rounded-lg bg-surface-mint text-brand-forest flex items-center justify-center shrink-0 mt-0.5">
                <!-- TablerIcon: brand-whatsapp -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9" />
                  <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-forest">Capa 1 · Interacción</div>
                <div class="text-sm font-bold text-content-main">WhatsApp Business Cloud API</div>
                <p class="text-sm text-content-muted mt-1 leading-relaxed">
                  Recepción de mensajes, notas de voz y documentos verificando el número telefónico del colaborador y su membresía activa.
                </p>
              </div>
            </div>

            <div class="bg-white rounded-xl p-4 flex items-start gap-3.5">
              <div class="w-9 h-9 rounded-lg bg-surface-mint text-brand-forest flex items-center justify-center shrink-0 mt-0.5">
                <!-- TablerIcon: settings -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" />
                  <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-forest">Capa 2 · Motor de reglas</div>
                <div class="text-sm font-bold text-content-main">Orquestador y Guardrails MeowLab</div>
                <p class="text-sm text-content-muted mt-1 leading-relaxed">
                  Validación de esquemas, control de permisos por rol, confirmación previa para escrituras y registro de auditoría.
                </p>
              </div>
            </div>

            <div class="bg-white rounded-xl p-4 flex items-start gap-3.5">
              <div class="w-9 h-9 rounded-lg bg-surface-mint text-brand-forest flex items-center justify-center shrink-0 mt-0.5">
                <!-- TablerIcon: database -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 6m-8 0a8 3 0 1 0 16 0a8 3 0 1 0 -16 0" />
                  <path d="M4 6v6a8 3 0 0 0 16 0v-6" />
                  <path d="M4 12v6a8 3 0 0 0 16 0v-6" />
                </svg>
              </div>
              <div>
                <div class="text-sm font-semibold text-brand-forest">Capa 3 · Tus datos</div>
                <div class="text-sm font-bold text-content-main">Base de Datos y ERP Corporativo</div>
                <p class="text-sm text-content-muted mt-1 leading-relaxed">
                  Conexión cifrada a PostgreSQL, SQL Server, SAP u Odoo en tu propia nube (AWS, GCP, Azure) o servidor privado.
                </p>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <!-- Comparison Table: Agente de Rol vs. Solución Dedicada -->
      <section class="space-y-6">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-content-main tracking-tight">
            Agente de rol vs. solución dedicada
          </h2>
          <p class="text-content-muted text-sm sm:text-base mt-2">
            Elige un asistente listo para usar o una integración privada conectada a los sistemas internos de tu empresa.
          </p>
        </div>

        <div class="bg-surface-subtle rounded-2xl overflow-hidden p-1">
          <div class="overflow-x-auto bg-white rounded-xl">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="border-b border-surface-border bg-surface-subtle text-sm font-title normal-case text-content-muted">
                  <th class="py-4 px-6 font-bold">Criterio técnico</th>
                  <th class="py-4 px-6 font-bold">Agente de rol (SaaS)</th>
                  <th class="py-4 px-6 font-bold bg-surface-mint/40 text-brand-forest">Solución dedicada</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-surface-border text-sm">
                {comparisonRows.map((row) => (
                  <tr>
                    <td class="py-4 px-6 font-semibold text-content-main">{row.feature}</td>
                    <td class="py-4 px-6 text-content-muted">{row.roleAgent}</td>
                    <td class="py-4 px-6 bg-surface-mint/40 text-content-main font-medium">
                      <div class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-brand-forest mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M5 12l5 5l10 -10" />
                        </svg>
                        <span>{row.dedicated}</span>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 4-Step Implementation Process -->
      <section class="space-y-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-content-main tracking-tight">
            Implementación en 4 etapas
          </h2>
          <p class="text-content-muted text-sm sm:text-base mt-2">
            Metodología estructurada de 5 a 10 días hábiles para conectar, validar y desplegar tu asistente sin interrumpir tu operación.
          </p>
        </div>

        <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {implementationSteps.map((step) => (
            <li class="bg-surface-subtle rounded-2xl p-6 space-y-2">
              <div class="flex items-baseline justify-between gap-2">
                <span class="tabular-nums text-sm font-bold text-brand-forest">{step.number}</span>
                <span class="text-sm tabular-nums text-content-muted">{step.timeline}</span>
              </div>
              <h3 class="text-lg font-bold text-content-main">{step.title}</h3>
              <p class="text-sm text-content-muted leading-relaxed">
                {step.description}
              </p>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </div>

  <CtaBanner />
</Layout>
