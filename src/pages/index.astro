---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import AgentesDetalle from '../components/AgentesDetalle.astro';
import DashboardSupervision from '../components/DashboardSupervision.astro';
import EquipoGatos from '../components/EquipoGatos.astro';
import Faq from '../components/Faq.astro';
---

<Layout
  title="meowlab | Agentes de IA en WhatsApp para Empresas"
  description="Delega ventas, facturación electrónica SUNAT y compras del Estado con agentes inteligentes en WhatsApp. Diseñado para pymes y operaciones reales."
>
  <!-- 1. Hero Section con simulador interactivo -->
  <Hero />

  <!-- 2. Catálogo de agentes y vista de detalle con casos de uso -->
  <AgentesDetalle />

  <!-- 3. Mini sección de dashboard, modularidad y supervisión -->
  <DashboardSupervision />

  <!-- 4. Coordinación multi-agente para negocios -->
  <EquipoGatos />

  <!-- 5. Preguntas frecuentes (FAQ con modularidad) -->
  <Faq />
</Layout>
