---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import Phone from '../components/landing/Phone.astro';
import { heroChat, tourChats, teamChat } from '../components/landing/chats';
import '../styles/home.css';

const portal = 'https://app.meowlab.tech';

// The seven cats of the tour, in the order a business meets them. Each line says only what the cat
// does today (ADR-0011 to ADR-0017).
const cats = [
  { key: 'invoice', name: 'Invoice Cat', job: 'Factura', text: 'Emite facturas, boletas, notas de crédito y guías de remisión ante SUNAT. Tú confirmas el borrador y recibes el PDF.' },
  { key: 'sales', name: 'Sales Cat', job: 'Vende', text: 'Registra tus ventas al contado o al crédito y arma cotizaciones en PDF para que se las reenvíes a tus clientes.' },
  { key: 'stock', name: 'Stock Cat', job: 'Cuida tu stock', text: 'Lleva tu inventario. Las entradas se las dices o le mandas la foto de la factura; las salidas bajan solas con tus ventas.' },
  { key: 'reorder', name: 'Reorder Cat', job: 'Repone', text: 'Cuando algo baja del mínimo te propone el pedido y, si lo apruebas, le escribe al proveedor a nombre de tu negocio.' },
  { key: 'collections', name: 'Collections Cat', job: 'Cobra', text: 'Lleva lo que te deben, lee las capturas de pago y te prepara los recordatorios, que envías con un botón.' },
  { key: 'support', name: 'Support Cat', job: 'Atiende', text: 'Responde a tus clientes las 24 horas en el WhatsApp de tu empresa. Lo que no sabe te lo pregunta a ti.' },
  { key: 'tender', name: 'Tender Cat', job: 'Busca licitaciones', text: 'Revisa el SEACE por ti y te avisa cuando sale una licitación de lo que vendes.' },
];

// What the panel shows on its home screen today, one line per cat (as WeeklyHome in apps/meowlab-app).
const today = [
  { logo: 'invoice-cat', name: 'Invoice Cat', line: '3 comprobantes por S/ 820.00' },
  { logo: 'sales-cat', name: 'Sales Cat', line: '18 ventas esta semana' },
  { logo: 'collections-cat', name: 'Collections Cat', line: 'Te deben S/ 1,650.00' },
  { logo: 'reorder-cat', name: 'Reorder Cat', line: '2 pedidos en camino' },
  { logo: 'support-cat', name: 'Support Cat', line: '12 clientes atendidos, 9 sin ti' },
  { logo: 'stock-cat', name: 'Stock Cat', line: '1 producto bajo el mínimo' },
];

const chats = { hero: heroChat, tour: tourChats, team: teamChat };
---

<LandingLayout
  title="MeowLab: agentes de IA en WhatsApp para mypes del Perú"
  description="Le escribes a MeowLab por WhatsApp y sus gatos facturan ante SUNAT, registran ventas, llevan tu stock y tus cobros, le piden a tus proveedores, atienden a tus clientes y te avisan de licitaciones del SEACE."
>
  <LandingNav />

  <main id="top">
    <section class="hero hero--split ml-hero" data-enter aria-labelledby="hero-h">
      <div class="wrap">
        <div class="hero-text grid hero__grid">
          <div class="hero__text span-6">
            <h1 id="hero-h">Agentes de IA en WhatsApp para mypes peruanas</h1>
            <p class="hero__lead">Le escribes a MeowLab como a alguien de tu equipo y el gato que corresponde lo hace: factura, vende, cobra, repone y atiende a tus clientes.</p>
            <div class="btn-row">
              <a class="btn btn--primary" href={portal}>Entrar al portal</a>
              <a class="btn btn--secondary" href="#gatos">Conoce a los gatos</a>
            </div>
          </div>
          <div class="ml-hero__art span-5 start-8">
            <Phone id="hero-phone" eager label="Chat de WhatsApp con MeowLab: pides una factura y puedes tocar Emitir o Corregir." name={heroChat.name} sub={heroChat.sub} avatar={heroChat.avatar} />
            <p class="ml-hint" id="hero-hint">Toca un botón del chat</p>
            <button class="ml-again" type="button" id="hero-again" hidden>Volver a empezar</button>
          </div>
        </div>
      </div>
    </section>

    <section class="section ml-tour" id="gatos" aria-labelledby="gatos-h">
      <div class="wrap">
        <div class="ml-tour__intro">
          <p class="t-label">Los gatos</p>
          <h2 id="gatos-h">Siete gatos, cada uno con su oficio</h2>
          <p class="t-lead">Un gato es un agente de IA que se encarga de una parte de tu negocio. No instalas nada: todos trabajan en tu WhatsApp y contratas solo los que necesitas.</p>
        </div>
        <div class="ml-tour__body">
          <ol class="ml-tour__steps">
            {cats.map((c, i) => (
              <li class="ml-step" id={`gato-${c.key}`} data-cat={c.key}>
                <span class="ml-step__logo"><img src={`/assets/agents/${c.key}-cat.webp`} alt="" width="64" height="64" loading="lazy" /></span>
                <span class="ml-step__n">{String(i + 1).padStart(2, '0')} · {c.job}</span>
                <h3>{c.name}</h3>
                <p>{c.text}</p>
              </li>
            ))}
          </ol>
          <div class="ml-tour__stage">
            <Phone id="tour-phone" label="Chat de WhatsApp que muestra al gato de cada paso en acción." name="MeowLab" sub="en línea" avatar="mark" />
            <nav class="ml-rail" aria-label="Ir a un gato">
              {cats.map((c) => <a href={`#gato-${c.key}`} data-cat={c.key} aria-label={c.name}><img src={`/assets/agents/${c.key}-cat.webp`} alt="" width="32" height="32" loading="lazy" /></a>)}
            </nav>
          </div>
        </div>
      </div>
    </section>

    <section class="section ml-team" id="juntos" aria-labelledby="juntos-h">
      <div class="wrap">
        <div class="ml-team__grid">
          <div class="ml-team__text">
            <p class="t-label">En equipo</p>
            <h2 id="juntos-h">Los gatos trabajan juntos</h2>
            <p class="t-lead">Una clienta escribe a las 11 de la noche. Mira lo que pasa por dentro.</p>
            <ol class="ml-hands" id="team-hands" aria-live="polite"></ol>
            <button class="ml-again" type="button" id="team-again" hidden>Ver de nuevo</button>
          </div>
          <div class="ml-team__stage">
            <Phone id="team-phone" label="Chat de WhatsApp de una clienta con la empresa: pide una cotización y pregunta por papel A3." name={teamChat.name} sub={teamChat.sub} avatar={teamChat.avatar} />
          </div>
        </div>
      </div>
    </section>

    <section class="section ground-surface ml-panel-sec" id="panel" aria-labelledby="panel-h">
      <div class="wrap">
        <div class="ml-panel-sec__head">
          <h2 id="panel-h">Y todo queda en tu panel</h2>
          <p class="t-lead">Entras con tu correo o con Google y ves lo que hizo cada gato hoy, lo que necesita tu atención y cada PDF.</p>
        </div>
        <div class="ml-app" role="img" aria-label="El panel de MeowLab: el resumen de hoy con lo que hizo cada gato y un comprobante que pide tu atención.">
          <aside class="ml-app__side">
            <span class="ml-app__logo"><img src="/assets/landing/meowlab-mark.png" alt="" width="22" height="22" loading="lazy" /><span>meow<b>lab</b></span></span>
            <span class="is-on">Inicio</span>
            <span>Tus agentes</span>
            <span>Plan</span>
            <span>Configuración</span>
            <span class="ml-app__co"><b>Moda Killa</b>Rosa Huamán · Dueña</span>
          </aside>
          <div class="ml-app__main">
            <div class="ml-app__today">
              <small>Domingo 16 de noviembre</small>
              <b class="ml-app__hello">Hola, Rosa</b>
              <span>Esto hicieron hoy tus agentes para Moda Killa</span>
              <ul>
                {today.map((t, i) => (
                  <li style={`--i: ${i}`}><span class="ml-app__logo-cat"><img src={`/assets/agents/${t.logo}.webp`} alt="" width="36" height="36" loading="lazy" /></span><span><b>{t.name}</b>{t.line}</span></li>
                ))}
              </ul>
            </div>
            <div class="ml-app__attn">
              <b>Para atender</b>
              <div class="ml-app__item"><span><b>F001-247 rechazado por SUNAT</b>Distribuidora Rímac · revisa el RUC del cliente</span><span class="ml-app__btn">Ver en Invoice Cat</span></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section ml-faq" id="preguntas" aria-labelledby="preguntas-h">
      <div class="wrap">
        <div class="ml-faq__grid">
          <div>
            <h2 id="preguntas-h">Preguntas frecuentes</h2>
            <p class="t-lead">¿Otra duda? <a class="link" href="/contacto">Escríbenos</a></p>
          </div>
          <div class="ml-faq__list">
            <details open>
              <summary>¿Necesito otro número de WhatsApp?</summary>
              <p>No. Tú y tu equipo le escriben a MeowLab en un solo chat y responde el gato que corresponde. Support Cat es el único que, además, atiende a tus clientes, y lo hace en el WhatsApp de tu empresa.</p>
            </details>
            <details>
              <summary>¿Tengo que instalar algo?</summary>
              <p>No. Los gatos trabajan en WhatsApp y tu panel se abre en el navegador, con tu correo o tu cuenta de Google.</p>
            </details>
            <details>
              <summary>¿Los comprobantes valen ante SUNAT?</summary>
              <p>Sí. Invoice Cat los emite ante SUNAT con FacturaYa, después de que confirmas el borrador en el chat.</p>
            </details>
            <details>
              <summary>¿Cuánto cuesta?</summary>
              <p>Cada gato cuesta de S/ 25 a S/ 59 al mes, con IGV, y pagas menos si llevas varios. Pagas con una suscripción de Mercado Pago. <a class="link" href="/precios">Ver los precios</a></p>
            </details>
            <details>
              <summary>¿Puedo empezar con un solo gato?</summary>
              <p>Sí. Contratas solo los que necesitas y sumas otros cuando quieras.</p>
            </details>
          </div>
        </div>
      </div>
    </section>
  </main>

  <LandingFooter />

  <script type="application/json" id="ml-chats" set:html={JSON.stringify(chats)} />
  <script>
    import { Player, handoffCard } from '../scripts/chat';
    import type { Chat } from '../components/landing/chats';

    const data = JSON.parse(document.getElementById('ml-chats')!.textContent!) as { hero: Chat; tour: Record<string, Chat>; team: Chat };
    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

    // Hero: plays once it is on screen; the visitor's tap moves it on.
    const heroAgain = $<HTMLButtonElement>('hero-again');
    const hero = new Player($('hero-phone'), { onEnd: () => { heroAgain.hidden = false; $('hero-hint').hidden = true; } });
    const playHero = () => { heroAgain.hidden = true; $('hero-hint').hidden = false; hero.run(data.hero); };
    heroAgain.addEventListener('click', playHero);
    playHero();

    // Tour: the step in the middle of the screen chooses the conversation of the sticky phone.
    const tourPhone = $('tour-phone');
    const tour = new Player(tourPhone);
    const steps = [...document.querySelectorAll<HTMLElement>('.ml-step')];
    let current = '';
    const pick = (key: string) => {
      if (key === current) return;
      current = key;
      steps.forEach((s) => s.classList.toggle('is-on', s.dataset.cat === key));
      document.querySelectorAll<HTMLElement>('.ml-rail a').forEach((a) => a.toggleAttribute('aria-current', a.dataset.cat === key));
      tour.header(data.tour[key]);
      tour.run(data.tour[key]);
    };
    const tourIO = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) pick((e.target as HTMLElement).dataset.cat!); });
    }, { rootMargin: window.matchMedia('(max-width: 639px)').matches ? '-72% 0px -18% 0px' : '-45% 0px -45% 0px' });
    steps.forEach((s) => tourIO.observe(s));
    // the phone is never empty: the first cat plays as soon as the tour comes into view
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) { if (!current) pick(steps[0].dataset.cat!); io.disconnect(); }
    }, { threshold: 0.2 }).observe(tourPhone);

    // The cats working together: plays when the section comes into view, once; «Ver de nuevo» replays it.
    const hands = $('team-hands');
    const teamAgain = $<HTMLButtonElement>('team-again');
    const team = new Player($('team-phone'), {
      onHandoff: (h) => { hands.append(handoffCard(h)); },
      onEnd: () => { teamAgain.hidden = false; },
    });
    const playTeam = () => { hands.innerHTML = ''; teamAgain.hidden = true; team.run(data.team); };
    teamAgain.addEventListener('click', playTeam);
    let teamPlayed = false;
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting) && !teamPlayed) { teamPlayed = true; playTeam(); io.disconnect(); }
    }, { threshold: 0.35 }).observe($('juntos'));

    // The panel: its lines arrive one after the other when it comes into view.
    new IntersectionObserver((entries, io) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.disconnect(); } });
    }, { threshold: 0.3 }).observe(document.querySelector('.ml-app')!);
  </script>
</LandingLayout>
