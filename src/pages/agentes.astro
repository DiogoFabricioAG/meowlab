---
import Layout from '../layouts/Layout.astro';
import CtaBanner from '../components/CtaBanner.astro';

const allAgents = [
  {
    id: 'tendercat',
    name: 'TenderCat',
    role: 'Buscador de Licitaciones y SEACE',
    category: 'ventas',
    type: 'Servicio Micro-SaaS',
    image: '/assets/gato-licitaciones.png',
    badge: 'Licitaciones',
    description: 'Rastrea convocatorias públicas en SEACE y Gob.pe diariamente. Filtra oportunidades por tu RNP y envía montos, bases y cronogramas listos para evaluar.',
    specs: {
      speed: '< 2.0s',
      input: 'RNP, rubro comercial, región geográfica',
      output: 'Reporte diario matutino + resumen de bases',
      integration: 'SEACE, Gob.pe, WhatsApp Business'
    }
  },
  {
    id: 'billcat',
    name: 'BillCat',
    role: 'Asistente de Facturación Electrónica',
    category: 'finanzas',
    type: 'Servicio Micro-SaaS',
    image: '/assets/gato-facturas.png',
    badge: 'Facturación',
    featured: true,
    description: 'Prepara borradores y comprobantes electrónicos a partir de notas de voz, fotos de pedidos o mensajes de texto, validando RUC y montos antes de emitir.',
    specs: {
      speed: '< 1.2s',
      input: 'Audio, foto, texto libre en WhatsApp',
      output: 'Borrador validado, PDF y XML',
      integration: 'WhatsApp Cloud API / Proveedor PSE-OSE'
    }
  },
  {
    id: 'huntercat',
    name: 'HunterCat',
    role: 'Calificador Comercial y Captación de Leads',
    category: 'ventas',
    type: 'Dedicado / SaaS',
    image: '/assets/gato-ventas.png',
    badge: 'Comercial',
    description: 'Atiende prospectos entrantes por WhatsApp, filtra oportunidades según presupuesto o requerimiento y coordina reuniones en el calendario del equipo.',
    specs: {
      speed: '< 1.8s',
      input: 'Consultas de WhatsApp, campañas entrantes',
      output: 'Lead calificado en CRM + cita agendada',
      integration: 'HubSpot, Pipedrive, Google Calendar'
    }
  },
  {
    id: 'nexuscat',
    name: 'NexusCat Private ERP',
    role: 'Conector Privado de Base de Datos y ERP',
    category: 'dedicado',
    type: 'Exclusivo Dedicado',
    image: '/assets/gato-licitaciones.png',
    badge: 'Enterprise',
    description: 'Asistente interno conectado a tu infraestructura privada. Ejecuta consultas seguras de solo lectura o flujos autorizados sobre stock, saldos y despachos.',
    specs: {
      speed: '< 2.0s',
      input: 'Consultas operativas en lenguaje natural',
      output: 'Reportes tabulares, saldos y alertas',
      integration: 'PostgreSQL, SAP, MySQL, REST API'
    }
  },
  {
    id: 'pawscollect',
    name: 'PawsCollect',
    role: 'Seguimiento de Cobranzas y Recordatorios',
    category: 'finanzas',
    type: 'Servicio Micro-SaaS',
    image: '/assets/gato-facturas.png',
    badge: 'Cobranzas',
    description: 'Realiza seguimiento cordial a comprobantes por vencer o vencidos, comparte enlaces de pago autorizados y registra confirmaciones de abono.',
    specs: {
      speed: '< 1.5s',
      input: 'Cronograma de vencimientos y estados de cuenta',
      output: 'Recordatorios programados + estado de cobro',
      integration: 'Links de pago, transferencias, ERP'
    }
  },
  {
    id: 'whiskercare',
    name: 'WhiskerCare',
    role: 'Atención al Cliente y Mesa de Ayuda',
    category: 'soporte',
    type: 'Dedicado / SaaS',
    image: '/assets/gato-ventas.png',
    badge: 'Soporte',
    description: 'Resuelve preguntas frecuentes sobre estado de pedidos, garantías o trámites y deriva casos complejos a un asesor humano con el contexto resumido.',
    specs: {
      speed: '< 1.0s',
      input: 'Consultas de clientes y números de pedido',
      output: 'Respuesta inmediata + escalado con resumen',
      integration: 'Zendesk, Shopify, WooCommerce, API propia'
    }
  }
];
---

<Layout
  title="Catálogo de Especialistas de IA en WhatsApp | MeowLab"
  description="Explora los roles especializados de MeowLab en WhatsApp: facturación electrónica, licitaciones SEACE, cobranzas y conexión dedicada a ERP."
>
  <div class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Page Header (no eyebrow pill per #rule-hero-eyebrow-chip) -->
      <div class="max-w-3xl mb-10 sm:mb-12">
        <h1 class="text-3xl sm:text-5xl font-bold text-content-main tracking-tight text-balance">
          Catálogo de Especialistas para <span class="text-brand-forest">Operar en WhatsApp</span>
        </h1>
        <p class="text-content-muted text-base sm:text-lg mt-4 leading-relaxed">
          Cada asistente cumple una función operativa delimitada, con reglas de negocio claras y trazabilidad en cada respuesta.
        </p>

        <!-- Category Filters -->
        <div class="flex flex-wrap items-center gap-2 mt-8" id="catalog-filters">
          <button
            data-cat="all"
            class="filter-btn px-4 py-2 rounded-xl text-xs font-title font-bold bg-brand-forest text-white border border-brand-forest transition-colors"
          >
            Todos los roles
          </button>
          <button
            data-cat="dedicado"
            class="filter-btn px-4 py-2 rounded-xl text-xs font-title font-bold bg-surface-subtle border border-surface-border text-content-muted hover:text-content-main transition-colors"
          >
            Dedicados ERP / DB
          </button>
          <button
            data-cat="finanzas"
            class="filter-btn px-4 py-2 rounded-xl text-xs font-title font-bold bg-surface-subtle border border-surface-border text-content-muted hover:text-content-main transition-colors"
          >
            Facturación y Cobros
          </button>
          <button
            data-cat="ventas"
            class="filter-btn px-4 py-2 rounded-xl text-xs font-title font-bold bg-surface-subtle border border-surface-border text-content-muted hover:text-content-main transition-colors"
          >
            Licitaciones y Ventas
          </button>
          <button
            data-cat="soporte"
            class="filter-btn px-4 py-2 rounded-xl text-xs font-title font-bold bg-surface-subtle border border-surface-border text-content-muted hover:text-content-main transition-colors"
          >
            Soporte y Trámites
          </button>
        </div>
      </div>

      <!-- Agent Cards Grid (no nested cards inside cards per #rule-nested-cards) -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8" id="catalog-grid">
        {allAgents.map((agent) => (
          <article
            class={`agent-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-colors ${
              agent.featured
                ? 'bg-surface-subtle border-2 border-brand-forest'
                : 'bg-white border border-surface-border hover:border-brand-forest/40'
            }`}
            data-category={agent.category}
          >
            <div>
              <div class="flex items-start justify-between gap-4 mb-5">
                <div class="w-12 h-12 rounded-xl bg-surface-mint/60 border border-surface-border flex items-center justify-center p-1.5 overflow-hidden">
                  <img src={agent.image} alt={agent.name} class="w-full h-full object-contain" loading="lazy" />
                </div>
                <span class="text-xs font-title font-bold px-2.5 py-1 rounded-md bg-surface-mint text-brand-forest">
                  {agent.badge}
                </span>
              </div>

              <div class="mb-1 text-xs font-title font-semibold text-brand-forest">
                {agent.type}
              </div>
              <h2 class="text-xl font-bold text-content-main">
                {agent.name}
              </h2>
              <p class="text-xs font-medium text-content-muted mb-3">
                {agent.role}
              </p>

              <p class="text-sm text-content-muted leading-relaxed">
                {agent.description}
              </p>

              <!-- Flat specification rows using divide-y instead of a nested card -->
              <dl class="mt-5 pt-4 border-t border-surface-border divide-y divide-surface-border text-xs">
                <div class="py-2 flex justify-between gap-4">
                  <dt class="text-content-muted">Respuesta típica</dt>
                  <dd class="font-mono font-semibold text-content-main text-right">{agent.specs.speed}</dd>
                </div>
                <div class="py-2 flex justify-between gap-4">
                  <dt class="text-content-muted">Entrada</dt>
                  <dd class="text-content-main text-right">{agent.specs.input}</dd>
                </div>
                <div class="py-2 flex justify-between gap-4">
                  <dt class="text-content-muted">Resultado</dt>
                  <dd class="text-content-main text-right">{agent.specs.output}</dd>
                </div>
                <div class="py-2 flex justify-between gap-4">
                  <dt class="text-content-muted">Integración</dt>
                  <dd class="font-medium text-brand-forest text-right">{agent.specs.integration}</dd>
                </div>
              </dl>
            </div>

            <div class="pt-5 mt-2">
              <a
                href="/contacto"
                class="w-full py-3 px-4 rounded-xl text-center text-xs font-title font-bold bg-brand-forest text-white hover:bg-brand-forestDark inline-flex items-center justify-center gap-2 transition-colors"
              >
                <span>Consultar por {agent.name}</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Bottom 2-column section: Solución Dedicada & Cómo Funciona el Equipo -->
      <div class="mt-16 grid lg:grid-cols-2 gap-8">
        <!-- Column 1: Solución Dedicada (Tailor-Made) -->
        <section class="bg-surface-subtle border border-surface-border rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-surface-mint text-brand-forest flex items-center justify-center shrink-0">
                <!-- TablerIcon: building-store -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 21l18 0" />
                  <path d="M3 7v1a3 3 0 0 0 6 0v-1m0 1a3 3 0 0 0 6 0v-1m0 1a3 3 0 0 0 6 0v-1h-18l2 -4h14l2 4" />
                  <path d="M5 21l0 -10.15" />
                  <path d="M19 21l0 -10.15" />
                  <path d="M9 21v-4a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v4" />
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-content-main">Solución Dedicada (Tailor-Made)</h2>
                <p class="text-xs text-content-muted">Infraestructura aislada y conectores a medida</p>
              </div>
            </div>

            <p class="text-sm text-content-muted leading-relaxed mb-5">
              Cuando tu operación requiere conectarse a un ERP propio, aplicar reglas de aprobación internas o desplegarse en una nube privada, diseñamos un asistente exclusivo para tu organización.
            </p>

            <ul class="divide-y divide-surface-border border-t border-b border-surface-border text-sm">
              <li class="py-3 flex items-start gap-3">
                <svg class="w-4 h-4 text-brand-forest mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                <span class="text-content-main">Conexión directa a PostgreSQL, SQL Server, SAP Business One u Odoo.</span>
              </li>
              <li class="py-3 flex items-start gap-3">
                <svg class="w-4 h-4 text-brand-forest mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                <span class="text-content-main">Permisos por rol de usuario y validación de número telefónico autorizado.</span>
              </li>
              <li class="py-3 flex items-start gap-3">
                <svg class="w-4 h-4 text-brand-forest mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12l5 5l10 -10" />
                </svg>
                <span class="text-content-main">Despliegue en VPC propia con auditoría completa de consultas.</span>
              </li>
            </ul>
          </div>

          <div class="pt-6">
            <a
              href="/dedicado"
              class="inline-flex items-center gap-2 text-sm font-title font-bold text-brand-forest hover:text-brand-forestDark transition-colors"
            >
              <span>Ver arquitectura de Solución Dedicada</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </section>

        <!-- Column 2: Cómo Funciona el Equipo -->
        <section class="bg-surface-subtle border border-surface-border rounded-2xl p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-xl bg-surface-mint text-brand-forest flex items-center justify-center shrink-0">
                <!-- TablerIcon: users -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 7m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
                  <path d="M3 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                  <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                  <path d="M21 21v-2a4 4 0 0 0 -3 -3.85" />
                </svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-content-main">Cómo Funciona el Equipo</h2>
                <p class="text-xs text-content-muted">Colaboración entre tus operadores y los asistentes</p>
              </div>
            </div>

            <p class="text-sm text-content-muted leading-relaxed mb-5">
              Los especialistas de MeowLab no reemplazan el criterio de tu negocio: preparan información, validan datos y solicitan confirmación antes de ejecutar operaciones sensibles.
            </p>

            <div class="divide-y divide-surface-border border-t border-b border-surface-border text-sm">
              <div class="py-3 flex items-start justify-between gap-4">
                <div>
                  <div class="font-semibold text-content-main">1. Recepción en lenguaje natural</div>
                  <p class="text-xs text-content-muted mt-0.5">Tu equipo envía audios, textos o documentos desde su propio celular.</p>
                </div>
                <span class="text-xs font-mono text-brand-forest font-semibold shrink-0">WhatsApp</span>
              </div>
              <div class="py-3 flex items-start justify-between gap-4">
                <div>
                  <div class="font-semibold text-content-main">2. Validación y estructura</div>
                  <p class="text-xs text-content-muted mt-0.5">El asistente verifica RUC, montos o filtros y presenta un resumen claro.</p>
                </div>
                <span class="text-xs font-mono text-brand-forest font-semibold shrink-0">Control</span>
              </div>
              <div class="py-3 flex items-start justify-between gap-4">
                <div>
                  <div class="font-semibold text-content-main">3. Confirmación y entrega</div>
                  <p class="text-xs text-content-muted mt-0.5">Con tu aprobación explícita, genera el documento o actualiza tu sistema.</p>
                </div>
                <span class="text-xs font-mono text-brand-forest font-semibold shrink-0">Ejecución</span>
              </div>
            </div>
          </div>

          <div class="pt-6">
            <a
              href="/servicios"
              class="inline-flex items-center gap-2 text-sm font-title font-bold text-brand-forest hover:text-brand-forestDark transition-colors"
            >
              <span>Comparar modalidades de servicio</span>
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14" />
                <path d="m12 5 7 7-7 7" />
              </svg>
            </a>
          </div>
        </section>
      </div>
    </div>
  </div>

  <CtaBanner />
</Layout>

<script>
  function setupCatalogFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.agent-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-cat');

        buttons.forEach(b => {
          b.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-title font-bold bg-surface-subtle border border-surface-border text-content-muted hover:text-content-main transition-colors';
        });
        btn.className = 'filter-btn px-4 py-2 rounded-xl text-xs font-title font-bold bg-brand-forest text-white border border-brand-forest transition-colors';

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  setupCatalogFilters();
  document.addEventListener('astro:page-load', setupCatalogFilters);
</script>
