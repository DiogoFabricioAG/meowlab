---
// nav-centre (dealt): the words in the middle, the logo on the left line, the main action on the right line.
const portal = 'https://app.meowlab.tech';
---

<header class="nav nav--centre">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Saltar al contenido</a>
    <a class="nav__logo" href="#top"><img src="/assets/landing/meowlab-mark.png" alt="" width="26" height="26" /><span>meow<b>lab</b></span></a>
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item">
        <a class="nav__link" href="#agentes">Agentes <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            <div class="menu-col span-3">
              <p class="t-label">Disponibles hoy</p>
              <a href="#facturas">Invoice Cat<span>Facturas, boletas y guías</span></a>
              <a href="#licitaciones">Tender Cat<span>Licitaciones del SEACE</span></a>
            </div>
            <div class="menu-col span-3">
              <p class="t-label">Tu cuenta</p>
              <a href="#portal">Portal<span>Lo que hicieron tus gatos</span></a>
              <a href="#equipo">Equipo<span>Invitaciones por WhatsApp</span></a>
            </div>
            <a class="menu-card span-3 start-10" href="#agentes">
              <div class="panel menu-cats"><img src="/assets/landing/gato-ventas-md.webp" alt="Ilustración de Sales Cat, uno de los gatos de MeowLab" width="160" height="160" loading="lazy" /></div>
              <span class="t-card">Agentes</span>
              <span class="t-small muted">Precios mensuales con IGV</span>
            </a>
          </div>
        </div>
      </div>
      <div class="nav__item"><a class="nav__link" href="#portal">Portal</a></div>
      <div class="nav__item"><a class="nav__link" href="#equipo">Equipo</a></div>
      <div class="nav__item"><a class="nav__link" href="#preguntas">Preguntas</a></div>
    </nav>
    <div class="nav__actions">
      <a class="btn btn--primary" href={portal}>Entrar al portal</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menú">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
    </button>
  </div>
</header>
