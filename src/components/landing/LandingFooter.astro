---
// footer.closing: row 1 the dealt close (close-type), row 2 the dealt footer (footer-columns).
const portal = 'https://app.meowlab.tech';
const year = new Date().getFullYear();
const cats = ['invoice-cat', 'sales-cat', 'stock-cat', 'reorder-cat', 'collections-cat', 'support-cat', 'tender-cat'];
---

<footer class="footer closing" id="contact" aria-labelledby="close-h">
  <div class="wrap">
    <div class="closing__cta ml-close">
      <div class="ml-close__text">
        <h2 id="close-h">Empieza con un gato y suma los que necesites</h2>
        <p>Entras con tu correo o con tu cuenta de Google. Desde S/ 25 al mes por gato, con IGV.</p>
        <div class="ml-close__btns">
          <a class="ml-close__main" href={portal}>Entrar al portal</a>
          <a class="ml-close__alt" href="/precios">Ver los precios</a>
        </div>
      </div>
      <div class="ml-close__cats" aria-hidden="true">
        {cats.map((c) => <span><img src={`/assets/agents/${c}.webp`} alt="" width="44" height="44" loading="lazy" /></span>)}
      </div>
    </div>
    <div class="closing__links">
      <div class="grid">
        <div class="span-4 stack-4">
          <a class="nav__logo" href="/"><img src="/assets/landing/meowlab-mark.png" alt="" width="26" height="26" loading="lazy" /><span>meow<b>lab</b></span></a>
          <p class="footer__lede">Agentes de IA en WhatsApp para mypes del Perú.</p>
        </div>
        <div class="span-2 footer__col"><h3>MeowLab</h3><ul><li><a href="/#gatos">Los gatos</a></li><li><a href="/#juntos">Cómo trabajan</a></li><li><a href="/#panel">Panel</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Planes</h3><ul><li><a href="/precios">Precios</a></li><li><a href={portal}>Entrar al portal</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Ayuda</h3><ul><li><a href="/#preguntas">Preguntas</a></li><li><a href="/contacto">Contacto</a></li></ul></div>
        <div class="span-2 footer__col"><h3>Legal</h3><ul><li><a href="/privacidad">Privacidad</a></li><li><a href="/terminos">Términos</a></li></ul></div>
      </div>
      <div class="footer__legal">
        <span>&copy; {year} MeowLab</span>
        <div class="socials"></div>
      </div>
    </div>
  </div>
</footer>
