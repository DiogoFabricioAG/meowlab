---
interface Props {
  className?: string;
  size?: 'sm' | 'md' | 'lg';
  theme?: 'dark' | 'light';
}

const { className = '', size = 'md', theme = 'dark' } = Astro.props;

const sizes = {
  sm: { imgSize: 'w-8 h-8', fontSize: 'text-base' },
  md: { imgSize: 'w-10 h-10', fontSize: 'text-xl' },
  lg: { imgSize: 'w-12 h-12', fontSize: 'text-2xl' },
};

const s = sizes[size] || sizes.md;
const isLight = theme === 'light';
---

<div class={`inline-flex items-center gap-2 select-none ${className}`}>
  <!-- Official MeowLab Black Cat Logo (No green box) -->
  <img 
    src="/assets/meowlab-black.png" 
    alt="MeowLab" 
    class={`${s.imgSize} object-contain mix-blend-multiply transition-transform group-hover:scale-105 shrink-0`} 
    loading="eager"
    decoding="async"
  />

  <!-- Wordmark: meowlab -->
  <span class={`font-title tracking-tight font-semibold flex items-center ${s.fontSize} ${isLight ? 'text-white' : 'text-content-main'}`}>
    <span>meow</span><span class={isLight ? 'text-brand-mint font-normal' : 'text-brand-forest font-bold'}>lab</span>
  </span>
</div>
