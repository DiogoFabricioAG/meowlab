const filterCategories = [
  { id: 'todos', label: 'Todos los casos (8)' },
  { id: 'ventas', label: 'Ventas y Clientes (3)' },
  { id: 'finanzas', label: 'Facturas y Cobros (2)' },
  { id: 'operaciones', label: 'Operaciones y Almacén (3)' },
];
---

<section class="py-20 md:py-28 bg-surface-subtle/60 border-y border-surface-border" id="agentes">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white border border-surface-border text-xs font-semibold text-content-main shadow-xs">
        <TablerIcon name="brand-whatsapp" size={15} className="text-[#25D366]" strokeWidth={2.2} />
        <span>Casos de uso reales y comprobados</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-content-main tracking-tight">
        Pequeños agentes que trabajan por ti en segundo plano.
      </h2>
      <p class="text-lg text-content-secondary leading-relaxed font-normal max-w-2xl mx-auto">
        Descubre todo lo que pueden resolver en tu día a día. Procesos concretos que te ahorran horas de oficina, errores manuales y llamadas innecesarias:
      </p>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 pb-8" role="tablist" aria-label="Filtrar casos de uso">
      {filterCategories.map((cat, index) => (
        <button
          type="button"
          data-filter={cat.id}
          class={`filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 ${
            index === 0
              ? 'bg-brand-forest text-white shadow-xs'
              : 'bg-white text-content-secondary border border-surface-border hover:border-brand-mint hover:text-brand-forest'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 8 Cards Grid (2-Column Responsive Layout with Rich Graphical Blocks) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8" id="agents-grid">
      {agents.map((agent) => (
        <div 
          class="agent-card card-clean p-6 sm:p-7 flex flex-col justify-between group transition-all duration-300 hover:border-brand-mint hover:shadow-soft bg-white rounded-3xl border border-surface-border"
          data-category={agent.category}
        >
          
          <!-- Top Content Area -->
          <div class="space-y-4">
            <!-- Header with Category, Icon & Status -->
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-brand-mint-light border border-brand-mint/60 flex items-center justify-center text-brand-forest group-hover:bg-brand-mint/60 group-hover:scale-105 transition-all duration-200 flex-shrink-0">
                  <TablerIcon name={agent.tablerIcon} size={22} strokeWidth={1.75} />
                </div>
                <div>
                  <span class="text-[11px] font-semibold text-brand-forest uppercase tracking-wider block font-mono">
                    {agent.categoryLabel}
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-content-main leading-snug">
                    {agent.title}
                  </h3>
                </div>
              </div>

              <!-- Status Badge -->
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-surface-subtle border border-surface-border text-content-secondary flex-shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-[#25D366] animate-pulse"></span>
                <span>{agent.status}</span>
              </span>
            </div>

            <!-- Description -->
            <p class="text-sm text-content-secondary leading-relaxed font-normal">
              {agent.description}
            </p>

            <!-- Key Capabilities List (Graphical Resource 1) -->
            <div class="pt-3 border-t border-surface-border/70 space-y-2 text-xs text-content-secondary">
              {agent.features.map((feat) => (
                <div class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded-full bg-brand-mint-light border border-brand-mint/80 text-brand-forest flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
                  <span class="font-medium text-content-main">{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Graphical Resource Block: Structured Facts Panel & Highlight Strip -->
          <div class="pt-4 mt-4 border-t border-surface-border/70 space-y-3">
            <!-- Structured Metrics Panel (Graphical Resource 2) -->
            <div class="bg-surface-subtle/70 border border-surface-border rounded-2xl p-3 grid grid-cols-3 gap-2 text-center">
              {agent.metrics.map((m) => (
                <div class="space-y-0.5">
                  <div class="text-[10px] font-medium text-content-muted uppercase tracking-wider">{m.label}</div>
                  <div class="font-bold text-content-main text-xs">{m.value}</div>
                </div>
              ))}
            </div>

            <!-- Benefit Highlight Banner (Graphical Resource 3) -->
            <div class="px-3.5 py-2.5 rounded-xl bg-brand-mint-light/40 border border-brand-mint/60 flex items-center gap-2 text-xs text-brand-forest font-semibold">
              <TablerIcon name="bolt" size={15} strokeWidth={2.2} className="shrink-0 text-brand-forest" />
              <span class="truncate">{agent.highlight}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Custom Agent Bottom Callout -->
    <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-white border border-surface-border shadow-card flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1.5 text-center md:text-left">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-brand-mint text-brand-forest text-xs font-semibold">
          <span>¿Tienes otro proceso en tu negocio?</span>
        </div>
        <h4 class="text-lg sm:text-xl font-bold text-content-main">
          Creamos un asistente felino personalizado a tu medida
        </h4>
        <p class="text-sm text-content-secondary max-w-xl">
          Si usas un software específico, un formato de inventario propio o reglas especiales, podemos configurar y entrenar a tu agente en menos de 24 horas.
        </p>
      </div>

      <a
        href="https://wa.me/51987654321?text=Hola%20MeowLab,%20quiero%20un%20asistente%20personalizado%20para%20mi%20empresa."
        target="_blank"
        class="btn-primary flex-shrink-0 px-6 py-3.5 rounded-xl text-sm font-medium shadow-sm flex items-center gap-2"
      >
        <TablerIcon name="brand-whatsapp" size={18} strokeWidth={2} />
        <span>Pedir agente a medida</span>
      </a>
    </div>

  </div>
</section>

<!-- Filter Script -->
<script>
  function setupCategoryFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.agent-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-filter');

        // Update active button state
        filterBtns.forEach((b) => {
          b.classList.remove('bg-brand-forest', 'text-white', 'shadow-xs');
          b.classList.add('bg-white', 'text-content-secondary', 'border', 'border-surface-border');
        });
        btn.classList.remove('bg-white', 'text-content-secondary', 'border', 'border-surface-border');
        btn.classList.add('bg-brand-forest', 'text-white', 'shadow-xs');

        // Filter cards
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (category === 'todos' || cardCat === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  setupCategoryFilters();
  document.addEventListener('astro:page-load', setupCategoryFilters);
</script>
