const flagshipMascots = [
  {
    tag: 'Agente de facturas',
    number: '01 / 03',
    title: 'Facturas',
    desc: 'De un mensaje a un comprobante listo.',
    workingImg: '/assets/gato-facturas-light.svg',
    filterTarget: 'finanzas',
  },
  {
    tag: 'Agente de licitaciones',
    number: '02 / 03',
    title: 'Licitaciones',
    desc: 'Busca oportunidades que sí encajan contigo.',
    workingImg: '/assets/gato-licitaciones-light.svg',
    filterTarget: 'ventas',
  },
  {
    tag: 'Agente de ventas',
    number: '03 / 03',
    title: 'Ventas',
    desc: 'Responde, acompaña y mantiene la conversación.',
    workingImg: '/assets/gato-ventas-light.svg',
    filterTarget: 'ventas',
  },
];

const filterCategories = [
  { id: 'todos', label: 'Todos los casos (8)' },
  { id: 'ventas', label: 'Ventas y Clientes (3)' },
  { id: 'finanzas', label: 'Facturas y Cobros (2)' },
  { id: 'operaciones', label: 'Operaciones y Almacén (3)' },
];
---

<section class="py-20 md:py-28 bg-surface-subtle/60 border-y border-surface-border" id="agentes">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-10 space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1 rounded-full bg-white border border-surface-border text-xs font-semibold text-content-main shadow-xs">
        <TablerIcon name="brand-whatsapp" size={15} className="text-[#25D366]" strokeWidth={2.2} />
        <span>Gatos de MeowLab en acción</span>
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-content-main tracking-tight">
        Un gato para cada trabajo
      </h2>
      <p class="text-base sm:text-lg text-content-secondary leading-relaxed font-normal max-w-2xl mx-auto">
        Acércate a cada asistente para verlo entrar en acción y descubrir en qué puede ayudarte.
      </p>
    </div>

    <!-- Interactive Hero Trio: Mascot Stage Hover Cards -->
    <div class="mb-14">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6" id="mascot-cards-grid">
        {flagshipMascots.map((m) => (
          <button
            type="button"
            class="mascot-stage-card group"
            aria-pressed="false"
            data-filter-target={m.filterTarget}
            aria-label={`${m.tag}: ${m.title} - ${m.desc}`}
          >
            <!-- Top Meta Bar -->
            <span class="card-top flex items-center justify-between w-full px-7 pt-6 text-[11.5px] font-mono font-semibold uppercase tracking-wider text-brand-forest">
              <span>{m.tag}</span>
              <span class="number text-content-muted">{m.number}</span>
            </span>

            <!-- Mascot Stage -->
            <span class="mascot-stage">
              <img class="idle" src="/assets/meowlab-black.png" alt="" loading="eager" />
              <img class="working" src={m.workingImg} alt="" loading="eager" />
            </span>

            <!-- Bottom Content Bar -->
            <span class="card-bottom flex items-end justify-between w-full px-7 pb-7 gap-3">
              <span class="text-left block">
                <strong class="title block text-2xl sm:text-3xl font-bold text-content-main tracking-tight leading-tight mb-1.5 group-hover:text-brand-forest transition-colors">
                  {m.title}
                </strong>
                <span class="desc block text-xs sm:text-sm text-content-secondary leading-relaxed max-w-[220px]">
                  {m.desc}
                </span>
              </span>
              <span class="mascot-arrow" aria-hidden="true">↗</span>
            </span>
          </button>
        ))}
      </div>

      <!-- Interaction hint -->
      <p class="text-center text-xs text-content-muted mt-5 flex items-center justify-center gap-2 select-none">
        <span class="w-1.5 h-1.5 rounded-full bg-[#25D366] animate-pulse"></span>
        <span>Pasa el cursor sobre un gato · En móvil, tócalo</span>
      </p>
    </div>

    <!-- Transition Divider to 8 Operational Workflows -->
    <div class="pt-8 pb-8 flex items-center justify-center border-t border-surface-border/80">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-surface-border text-xs font-semibold text-content-main shadow-xs">
        <span>Conoce los 8 casos de uso especializados por área</span>
        <span class="text-brand-forest">↓</span>
      </div>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 pb-8" role="tablist" aria-label="Filtrar casos de uso">
      {filterCategories.map((cat, index) => (
        <button
          type="button"
          data-filter={cat.id}
          class={`filter-btn px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 ${
            index === 0
              ? 'bg-brand-forest text-white shadow-xs hover:text-white hover:bg-brand-forest-hover'
              : 'bg-white text-content-secondary border border-surface-border hover:border-brand-mint hover:text-brand-forest'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- 8 Cards Grid (2-Column Responsive Layout with Rich Graphical Blocks) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8" id="agents-grid">
      {agents.map((agent) => (
        <div 
          class="agent-card card-clean p-6 sm:p-7 flex flex-col justify-between group transition-all duration-300 hover:border-brand-mint hover:shadow-soft bg-white rounded-3xl border border-surface-border"
          data-category={agent.category}
        >
          
          <!-- Top Content Area -->
          <div class="space-y-4">
            <!-- Header with Category, Icon & Status -->
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-brand-mint-light border border-brand-mint/60 flex items-center justify-center text-brand-forest group-hover:bg-brand-mint/60 group-hover:scale-105 transition-all duration-200 flex-shrink-0 p-1 overflow-hidden">
                  {agent.image ? (
                    <img src={agent.image} alt={agent.title} class="w-full h-full object-contain mix-blend-multiply" />
                  ) : (
                    <TablerIcon name={agent.tablerIcon} size={22} strokeWidth={1.75} />
                  )}
                </div>
                <div>
                  <span class="text-[11px] font-semibold text-brand-forest uppercase tracking-wider block font-mono">
                    {agent.categoryLabel}
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-content-main leading-snug">
                    {agent.title}
                  </h3>
                </div>
              </div>

              <!-- Status Badge -->
              <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium bg-surface-subtle border border-surface-border text-content-secondary flex-shrink-0">
                <span class="w-1.5 h-1.5 rounded-full bg-[#25D366] animate-pulse"></span>
                <span>{agent.status}</span>
              </span>
            </div>

            <!-- Description -->
            <p class="text-sm text-content-secondary leading-relaxed font-normal">
              {agent.description}
            </p>

            <!-- Key Capabilities List (Graphical Resource 1) -->
            <div class="pt-3 border-t border-surface-border/70 space-y-2 text-xs text-content-secondary">
              {agent.features.map((feat) => (
                <div class="flex items-center gap-2">
                  <span class="w-4 h-4 rounded-full bg-brand-mint-light border border-brand-mint/80 text-brand-forest flex items-center justify-center text-[10px] font-bold shrink-0">✓</span>
                  <span class="font-medium text-content-main">{feat}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Graphical Resource Block: Structured Facts Panel & Highlight Strip -->
          <div class="pt-4 mt-4 border-t border-surface-border/70 space-y-3">
            <!-- Structured Metrics Panel (Graphical Resource 2) -->
            <div class="bg-surface-subtle/70 border border-surface-border rounded-2xl p-3 grid grid-cols-3 gap-2 text-center">
              {agent.metrics.map((m) => (
                <div class="space-y-0.5">
                  <div class="text-[10px] font-medium text-content-muted uppercase tracking-wider">{m.label}</div>
                  <div class="font-bold text-content-main text-xs">{m.value}</div>
                </div>
              ))}
            </div>

            <!-- Benefit Highlight Banner (Graphical Resource 3) -->
            <div class="px-3.5 py-2.5 rounded-xl bg-brand-mint-light/40 border border-brand-mint/60 flex items-center gap-2 text-xs text-brand-forest font-semibold">
              <TablerIcon name="bolt" size={15} strokeWidth={2.2} className="shrink-0 text-brand-forest" />
              <span class="truncate">{agent.highlight}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Custom Agent Bottom Callout -->
    <div class="mt-12 p-6 sm:p-8 rounded-3xl bg-white border border-surface-border shadow-card flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1.5 text-center md:text-left">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-brand-mint text-brand-forest text-xs font-semibold">
          <span>¿Tienes otro proceso en tu negocio?</span>
        </div>
        <h4 class="text-lg sm:text-xl font-bold text-content-main">
          Creamos un asistente felino personalizado a tu medida
        </h4>
        <p class="text-sm text-content-secondary max-w-xl">
          Si usas un software específico, un formato de inventario propio o reglas especiales, podemos configurar y entrenar a tu agente en menos de 24 horas.
        </p>
      </div>

      <a
        href="https://wa.me/51923790280?text=Hola%20MeowLab,%20quiero%20un%20asistente%20personalizado%20para%20mi%20empresa."
        target="_blank"
        class="btn-primary flex-shrink-0 px-6 py-3.5 rounded-xl text-sm font-medium shadow-sm flex items-center gap-2"
      >
        <TablerIcon name="brand-whatsapp" size={18} strokeWidth={2} />
        <span>Pedir agente a medida</span>
      </a>
    </div>

  </div>
</section>

<!-- Filter Script -->
<script>
  function setupCategoryFilters() {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.agent-card');

    const ACTIVE_CLASSES = ['bg-brand-forest', 'text-white', 'shadow-xs', 'hover:text-white', 'hover:bg-brand-forest-hover'];
    const INACTIVE_CLASSES = ['bg-white', 'text-content-secondary', 'border', 'border-surface-border', 'hover:border-brand-mint', 'hover:text-brand-forest'];

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-filter');

        // Update active button state
        filterBtns.forEach((b) => {
          b.classList.remove(...ACTIVE_CLASSES);
          b.classList.add(...INACTIVE_CLASSES);
        });
        btn.classList.remove(...INACTIVE_CLASSES);
        btn.classList.add(...ACTIVE_CLASSES);

        // Filter cards
        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (category === 'todos' || cardCat === category) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  }

  setupCategoryFilters();
  document.addEventListener('astro:page-load', setupCategoryFilters);

  // Touch & Click interaction for mobile/tablet
  function setupMascotCards() {
    const mascotCards = document.querySelectorAll('.mascot-stage-card');
    mascotCards.forEach((card) => {
      card.addEventListener('click', () => {
        const active = card.classList.toggle('is-active');
        card.setAttribute('aria-pressed', String(active));
      });
    });
  }

  setupMascotCards();
  document.addEventListener('astro:page-load', setupMascotCards);
</script>

<style>
  .mascot-stage-card {
    position: relative;
    overflow: hidden;
    min-height: 440px;
    padding: 0;
    text-align: left;
    border: 1px solid #E8ECE9;
    border-radius: 28px;
    color: inherit;
    background: #ffffff;
    cursor: pointer;
    isolation: isolate;
    transition: transform 0.42s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.3s, background 0.3s, box-shadow 0.3s;
    appearance: none;
    font: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    user-select: none;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
  }
  .mascot-stage-card:hover,
  .mascot-stage-card:focus-visible,
  .mascot-stage-card.is-active {
    transform: translateY(-6px);
    border-color: #BEE3D3;
    background: #ffffff;
    box-shadow: 0 16px 36px -8px rgba(12, 73, 60, 0.12), 0 4px 12px -2px rgba(0, 0, 0, 0.04);
  }
  .mascot-stage-card:focus-visible {
    outline: 2px solid #25D366;
    outline-offset: 4px;
  }
  .mascot-stage-card::after {
    content: "";
    position: absolute;
    z-index: 1;
    inset: 0;
    background: radial-gradient(circle at 50% 40%, rgba(216, 240, 229, 0.5), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }
  .mascot-stage-card:hover::after,
  .mascot-stage-card:focus-visible::after,
  .mascot-stage-card.is-active::after {
    opacity: 1;
  }
  .mascot-stage {
    position: relative;
    flex: 1;
    min-height: 275px;
    display: grid;
    place-items: center;
    margin: 4px 16px 0;
    z-index: 2;
  }
  .mascot-stage img {
    position: absolute;
    display: block;
    object-fit: contain;
    object-position: center;
    width: min(92%, 300px);
    height: 285px;
    user-select: none;
    pointer-events: none;
    mix-blend-mode: multiply;
    transition: opacity 0.35s ease, transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .mascot-stage .idle {
    width: min(84%, 270px);
    height: 265px;
    opacity: 1;
    transform: translateY(8px) scale(0.86);
  }
  .mascot-stage .working {
    opacity: 0;
    transform: translateY(35px) rotate(-7deg) scale(0.78);
  }
  .mascot-stage-card:hover .idle,
  .mascot-stage-card:focus-visible .idle,
  .mascot-stage-card.is-active .idle {
    opacity: 0;
    transform: translateY(-32px) rotate(8deg) scale(0.7);
  }
  .mascot-stage-card:hover .working,
  .mascot-stage-card:focus-visible .working,
  .mascot-stage-card.is-active .working {
    opacity: 1;
    transform: translateY(-2px) rotate(0) scale(1);
  }
  .mascot-arrow {
    display: grid;
    place-items: center;
    border: 1px solid #E2E8F0;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    flex: none;
    font-size: 1.1rem;
    background: #F8FAF9;
    color: #0C493C;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background 0.3s, color 0.3s, border-color 0.3s;
  }
  .mascot-stage-card:hover .mascot-arrow,
  .mascot-stage-card:focus-visible .mascot-arrow,
  .mascot-stage-card.is-active .mascot-arrow {
    transform: rotate(-45deg);
    background: #0C493C;
    color: #ffffff;
    border-color: #0C493C;
  }
</style>
