---
import TablerIcon from './ui/TablerIcon.astro';

// Comprehensive catalog of 8 functional business agents
const agents = [
  {
    id: 'licitaciones',
    category: 'ventas',
    categoryLabel: 'Compras del Estado',
    title: 'Buscador de Licitaciones y SEACE',
    description: 'Rastrea convocatorias públicas y privadas todos los días. Te envía un reporte matutino con los requerimientos, montos y fechas límite de postulación.',
    tablerIcon: 'file-search' as const,
    status: 'Alerta 8:00 a. m.',
    features: [
      'Monitoreo automático de SEACE y Gob.pe',
      'Filtrado por tu RNP, especialidad y región',
      'Bases completas y cronograma en PDF',
    ],
    metrics: [
      { label: 'Cobertura', value: 'Todo el Perú' },
      { label: 'Frecuencia', value: 'Cada mañana' },
      { label: 'Ahorro', value: '2 hrs / día' },
    ],
    highlight: 'Filtra compras públicas con montos desde S/ 50K hasta S/ 10M+',
  },
  {
    id: 'facturas',
    category: 'finanzas',
    categoryLabel: 'Comprobantes SUNAT',
    title: 'Emisión de Facturas y Boletas',
    description: 'Genera comprobantes electrónicos validados ante SUNAT con solo dictar los datos por mensaje o audio. Descarga y comparte el PDF y XML al instante.',
    tablerIcon: 'receipt-tax' as const,
    status: 'Validada ante SUNAT',
    features: [
      'Validación oficial directa ante SUNAT',
      'Facturas, boletas, notas de crédito y débito',
      'Envío automático de PDF y XML al cliente',
    ],
    metrics: [
      { label: 'Emisión', value: '< 10 segundos' },
      { label: 'Validez', value: '100% legal' },
      { label: 'Formato', value: 'PDF + XML' },
    ],
    highlight: 'Factura desde la calle o en obra sin entrar al portal de SUNAT',
  },
  {
    id: 'cotizaciones',
    category: 'ventas',
    categoryLabel: 'Cierre de Ventas',
    title: 'Creador de Cotizaciones y Proformas',
    description: 'Dile qué productos o servicios necesita tu cliente y te prepara una proforma institucional en PDF con tu logo, RUC, precios y condiciones de pago.',
    tablerIcon: 'file-invoice' as const,
    status: 'PDF con tu marca',
    features: [
      'Cálculo automático de IGV, subtotales y descuentos',
      'Plantilla elegante con tu logo y firma autorizada',
      'Vigencia y condiciones comerciales configurables',
    ],
    metrics: [
      { label: 'Diseño', value: 'Con tu logo' },
      { label: 'Formato', value: 'PDF listo' },
      { label: 'Velocidad', value: 'En 30 seg' },
    ],
    highlight: 'Cierra ventas al instante antes de que el cliente cotice con otro',
  },
  {
    id: 'almacen',
    category: 'operaciones',
    categoryLabel: 'Inventario y Almacén',
    title: 'Consultas de Almacén y Stock',
    description: 'Tu equipo comercial o de despacho puede preguntar cuánto stock queda de cualquier producto, en qué pasillo o sede está y a qué precio venderlo.',
    tablerIcon: 'package' as const,
    status: 'Stock en tiempo real',
    features: [
      'Consultas por voz o texto desde cualquier lugar',
      'Ubicación exacta por sede, nave y pasillo',
      'Precios diferenciados por cliente o volumen',
    ],
    metrics: [
      { label: 'Respuesta', value: 'Al segundo' },
      { label: 'Sincronía', value: 'En tiempo real' },
      { label: 'Uso', value: 'Vendedores' },
    ],
    highlight: 'Evita prometer productos agotados o perder tiempo llamando al almacén',
  },
  {
    id: 'cobranzas',
    category: 'finanzas',
    categoryLabel: 'Flujo de Caja',
    title: 'Gestor de Cobranzas y Cuentas por Cobrar',
    description: 'Monitorea qué clientes tienen facturas pendientes o por vencer y prepara recordatorios cordiales y respetuosos listos para enviar por WhatsApp.',
    tablerIcon: 'coin' as const,
    status: 'Control de liquidez',
    features: [
      'Monitoreo de vencimientos y cuentas por cobrar',
      'Borradores de mensajes de cobro amables y claros',
      'Reporte semanal de deudas y flujo proyectado',
    ],
    metrics: [
      { label: 'Control', value: 'Cero olvidos' },
      { label: 'Tono', value: 'Cordial y formal' },
      { label: 'Impacto', value: '+ Liquidez' },
    ],
    highlight: 'Cobra a tiempo sin desgastar la relación de confianza con tu cliente',
  },
  {
    id: 'tramites',
    category: 'operaciones',
    categoryLabel: 'Expedientes y Permisos',
    title: 'Seguimiento de Trámites y Licencias',
    description: 'Rastrea expedientes en municipalidades, Defensa Civil, inspecciones técnicas y registros obligatorios, alertándote con anticipación antes de cada plazo.',
    tablerIcon: 'clipboard-check' as const,
    status: 'Cero multas ni retrasos',
    features: [
      'Rastreo por número de expediente o resolución',
      'Alertas preventivas 15 y 5 días antes de vencer',
      'Checklist de requisitos para renovación de licencias',
    ],
    metrics: [
      { label: 'Entidades', value: 'Municipios y DC' },
      { label: 'Anticipación', value: 'Alertas previas' },
      { label: 'Resultado', value: 'Cero multas' },
    ],
    highlight: 'Mantén los permisos y licencias de tu local siempre al día',
  },
  {
    id: 'atencion',
    category: 'ventas',
    categoryLabel: 'Atención al Cliente',
    title: 'Atención a Clientes y Pedidos 24/7',
    description: 'Atiende consultas de compradores a cualquier hora: resuelve preguntas de tu catálogo, precios, cobertura de envíos y toma pedidos para tu equipo.',
    tablerIcon: 'messages' as const,
    status: 'Atención 24/7 continua',
    features: [
      'Respuestas amables e inmediatas día y noche',
      'Resolución de dudas frecuentes de catálogo y precios',
      'Registro de pedidos preliminares para tu personal',
    ],
    metrics: [
      { label: 'Horario', value: '24/7 continuo' },
      { label: 'Espera', value: '0 segundos' },
      { label: 'Capacidad', value: 'Multi-chat' },
    ],
    highlight: 'Capta clientes fuera de horario y fines de semana sin contratar turnos',
  },
  {
    id: 'datos',
    category: 'operaciones',
    categoryLabel: 'Integración a tus Datos',
    title: 'Conexión a tus Hojas de Cálculo y Datos',
    description: 'Enlaza a tu asistente con tus archivos Excel, Google Sheets o sistemas propios. Pídele por audio o texto tus ventas diarias, pedidos o números clave.',
    tablerIcon: 'database-cog' as const,
    status: 'Datos al bolsillo',
    features: [
      'Conexión segura con Google Sheets, Excel y SQL',
      'Consultas en lenguaje cotidiano por mensaje o audio',
      'Resúmenes ejecutivos diarios directo a tu celular',
    ],
    metrics: [
      { label: 'Conexión', value: 'Sheets y Excel' },
      { label: 'Entrada', value: 'Voz o texto' },
      { label: 'Reporte', value: 'Al instante' },
    ],
    highlight: 'Revisa la salud de tu negocio en 10 segundos mientras estás en ruta',
  },
