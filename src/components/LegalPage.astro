---
import Layout from '../layouts/Layout.astro';
import { legal } from '../data/legal';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<Layout title={title} description={description}>
  <article class="py-14 md:py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <header class="space-y-3 pb-8 mb-8 border-b border-surface-border">
        <p class="text-sm font-semibold text-brand-forest">MeowLab · Documento legal</p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-content-main tracking-tight leading-[1.15]">{heading}</h1>
        <p class="text-content-muted">Vigente desde el {legal.vigencia}.</p>
      </header>
      <div class="legal-prose">
        <slot />
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .legal-prose {
    color: #2d3a35;
    line-height: 1.7;
  }
  .legal-prose h2 {
    font-family: 'Blinker', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: #111816;
    margin: 2.25rem 0 0.75rem;
  }
  .legal-prose h3 {
    font-family: 'Blinker', sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: #111816;
    margin: 1.5rem 0 0.5rem;
  }
  .legal-prose p,
  .legal-prose ul {
    margin: 0 0 1rem;
  }
  .legal-prose ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal-prose li {
    margin: 0.35rem 0;
  }
  .legal-prose a {
    color: #0c493c;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal-prose strong {
    color: #111816;
  }
</style>
