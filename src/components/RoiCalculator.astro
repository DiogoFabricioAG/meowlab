---
---
<section class="py-24 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-neon/30 shadow-neon-lg">
      <div class="grid lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Sliders -->
        <div class="lg:col-span-7 space-y-8">
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-neon/10 border border-neon/30 text-neon text-xs font-title font-bold mb-3">
              <span>CALCULADORA DE RETORNO (ROI)</span>
            </div>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
              ¿Cuánto Ahorrará tu Empresa con <span class="text-neon">MeowLab</span>?
            </h2>
            <p class="text-slate-300 text-sm mt-2">
              Ajusta los parámetros según tu volumen de WhatsApp mensual y calcula el impacto en horas hombre y costo financiero.
            </p>
          </div>

          <!-- Slider 1: Mensajes/Consultas -->
          <div class="space-y-3">
            <div class="flex justify-between items-center text-sm font-title font-bold">
              <span class="text-slate-300">Mensajes / Consultas al mes en WhatsApp:</span>
              <span id="roi-msg-display" class="text-neon text-lg">5,000</span>
            </div>
            <input
              id="roi-msg-slider"
              type="range"
              min="500"
              max="50000"
              step="500"
              value="5000"
              class="w-full accent-neon cursor-pointer"
            />
            <div class="flex justify-between text-[11px] text-slate-500 font-mono">
              <span>500 msgs</span>
              <span>25,000 msgs</span>
              <span>50,000+ msgs</span>
            </div>
          </div>

          <!-- Slider 2: Costo por hora operador -->
          <div class="space-y-3">
            <div class="flex justify-between items-center text-sm font-title font-bold">
              <span class="text-slate-300">Costo promedio hora de atención humana (USD):</span>
              <span id="roi-cost-display" class="text-neon text-lg">$6.00</span>
            </div>
            <input
              id="roi-cost-slider"
              type="range"
              min="2"
              max="25"
              step="1"
              value="6"
              class="w-full accent-neon cursor-pointer"
            />
            <div class="flex justify-between text-[11px] text-slate-500 font-mono">
              <span>$2/hr</span>
              <span>$12/hr</span>
              <span>$25/hr</span>
            </div>
          </div>
        </div>

        <!-- Right: Results Card -->
        <div class="lg:col-span-5 bg-surface-elevated p-8 rounded-3xl border border-neon/40 shadow-card flex flex-col justify-between gap-6 text-center">
          <div>
            <span class="text-xs font-title font-extrabold uppercase tracking-widest text-slate-400">Ahorro Mensual Estimado</span>
            <div id="roi-savings-usd" class="text-5xl sm:text-6xl font-title font-black text-neon my-2">
              $1,500
            </div>
            <p class="text-xs text-slate-300">USD por mes en optimización operativa directa</p>
          </div>

          <div class="grid grid-cols-2 gap-4 border-y border-white/10 py-5">
            <div>
              <div id="roi-hours-saved" class="text-2xl sm:text-3xl font-title font-bold text-white">250 hrs</div>
              <div class="text-[11px] text-slate-400">Horas liberadas / mes</div>
            </div>
            <div>
              <div id="roi-pct" class="text-2xl sm:text-3xl font-title font-bold text-neon">85%</div>
              <div class="text-[11px] text-slate-400">Automatización total</div>
            </div>
          </div>

          <div>
            <a href="/contacto" class="btn-primary w-full py-3.5 rounded-xl font-title font-bold text-sm">
              Implementar este Agente Ahora 🐾
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupRoi() {
    const msgSlider = document.getElementById('roi-msg-slider') as HTMLInputElement;
    const costSlider = document.getElementById('roi-cost-slider') as HTMLInputElement;
    const msgDisplay = document.getElementById('roi-msg-display');
    const costDisplay = document.getElementById('roi-cost-display');
    const savingsUsd = document.getElementById('roi-savings-usd');
    const hoursSaved = document.getElementById('roi-hours-saved');

    function update() {
      if (!msgSlider || !costSlider) return;
      const msgs = parseInt(msgSlider.value, 10);
      const cost = parseInt(costSlider.value, 10);

      if (msgDisplay) msgDisplay.textContent = msgs.toLocaleString('en-US');
      if (costDisplay) costDisplay.textContent = `$${cost}.00`;

      // 1 message takes ~3 mins of human handling = 0.05 hr
      const totalHumanHours = msgs * 0.05;
      const automatedHours = totalHumanHours * 0.85;
      const totalSavings = Math.round(automatedHours * cost);

      if (savingsUsd) savingsUsd.textContent = `$${totalSavings.toLocaleString('en-US')}`;
      if (hoursSaved) hoursSaved.textContent = `${Math.round(automatedHours)} hrs`;
    }

    if (msgSlider) msgSlider.addEventListener('input', update);
    if (costSlider) costSlider.addEventListener('input', update);
    update();
  }

  setupRoi();
  document.addEventListener('astro:page-load', setupRoi);
</script>
