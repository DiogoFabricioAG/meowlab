---
import MeowLogo from './ui/MeowLogo.astro';
import TablerIcon from './ui/TablerIcon.astro';

const currentYear = new Date().getFullYear();

const assistantLinks = [
  { name: 'Buscador de Licitaciones', href: '/#agentes' },
  { name: 'Facturación Electrónica SUNAT', href: '/#agentes' },
  { name: 'Creador de Cotizaciones en PDF', href: '/#agentes' },
  { name: 'Consultas de Almacén y Stock', href: '/#agentes' },
  { name: 'Gestor de Cobranzas', href: '/#agentes' },
  { name: 'Atención a Clientes 24/7', href: '/#agentes' },
];

const platformLinks = [
  { name: '¿Cómo funciona?', href: '/#como-funciona' },
  { name: 'Simulador en WhatsApp', href: '/#empezar' },
  { name: 'Asistente personalizado', href: '/contacto' },
  { name: 'Conexión a Excel y Sheets', href: '/#agentes' },
  { name: 'Seguridad y Privacidad', href: '/contacto' },
];

const companyLinks = [
  { name: 'Iniciar sesión', href: '/contacto' },
  { name: 'Hablar con un asesor', href: 'https://wa.me/51987654321?text=Hola%20MeowLab,%20quiero%20conocer%20m%C3%A1s.' },
  { name: 'Preguntas frecuentes', href: '/contacto' },
  { name: 'Contacto directo', href: '/contacto' },
];
---

<footer class="bg-surface-subtle/40 border-t border-surface-border pt-16 pb-12 md:pt-20 md:pb-16 text-content-secondary">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Multi-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-14 border-b border-surface-border">
      
      <!-- Column 1: Brand, Value Proposition & WhatsApp Status (Span 5) -->
      <div class="lg:col-span-5 space-y-5">
        <a href="/" class="inline-block focus:outline-none focus:ring-2 focus:ring-brand-forest rounded-xl">
          <MeowLogo size="md" />
        </a>

        <p class="text-sm text-content-secondary leading-relaxed max-w-sm">
          Tu asistente inteligente en WhatsApp para hacer avanzar tu negocio. Monitorea compras del Estado, emite facturas ante SUNAT y consulta tu inventario sin salir de tu chat de siempre.
        </p>

        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white border border-surface-border text-xs font-semibold text-content-main shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span>
          <span>Sistemas operativos en WhatsApp</span>
        </div>

      </div>

      <!-- Column 2: Asistentes (Span 3) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-xs font-bold text-content-main uppercase tracking-wider font-mono">
          Asistentes para tu negocio
        </h3>
        <ul class="space-y-2.5 text-sm">
          {assistantLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-brand-forest transition-colors hover:translate-x-0.5 inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Plataforma (Span 2) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-xs font-bold text-content-main uppercase tracking-wider font-mono">
          Plataforma
        </h3>
        <ul class="space-y-2.5 text-sm">
          {platformLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-brand-forest transition-colors hover:translate-x-0.5 inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contacto & Acceso (Span 2) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-xs font-bold text-content-main uppercase tracking-wider font-mono">
          Contacto
        </h3>
        <ul class="space-y-2.5 text-sm">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-brand-forest transition-colors hover:translate-x-0.5 inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-2 text-xs text-content-muted">
          <p class="font-medium text-content-main">Lima, Perú</p>
          <p class="text-[11px] mt-0.5">Operaciones para todo el país</p>
        </div>
      </div>

    </div>

    <!-- Trust & Security Ribbon -->
    <div class="py-8 border-b border-surface-border grid grid-cols-1 sm:grid-cols-3 gap-6 text-xs text-content-secondary">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-brand-mint-light flex items-center justify-center text-brand-forest shrink-0">
          <TablerIcon name="brand-whatsapp" size={17} className="text-[#25D366]" strokeWidth={2} />
        </div>
        <div>
          <span class="font-bold text-content-main block">100% en WhatsApp</span>
          <span class="text-content-muted">Sin instalar apps ni programas nuevos</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-brand-mint-light flex items-center justify-center text-brand-forest shrink-0">
          <TablerIcon name="receipt-tax" size={17} strokeWidth={2} />
        </div>
        <div>
          <span class="font-bold text-content-main block">Validez oficial SUNAT</span>
          <span class="text-content-muted">Comprobantes legales con XML y PDF</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-brand-mint-light flex items-center justify-center text-brand-forest shrink-0">
          <TablerIcon name="check" size={17} strokeWidth={2.2} />
        </div>
        <div>
          <span class="font-bold text-content-main block">Privacidad garantizada</span>
          <span class="text-content-muted">Tus datos seguros y cifrados de extremo a extremo</span>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-content-muted">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <p>© {currentYear} MeowLab. Todos los derechos reservados.</p>
        <span class="hidden sm:inline text-surface-border">•</span>
        <p>Hecho en Perú para hacer avanzar a tu empresa.</p>
      </div>

      <div class="flex items-center gap-6">
        <a href="/contacto" class="hover:text-brand-forest transition-colors">Términos</a>
        <a href="/contacto" class="hover:text-brand-forest transition-colors">Privacidad</a>
        <a href="/contacto" class="hover:text-brand-forest transition-colors">Libro de Reclamaciones</a>
      </div>
    </div>

  </div>
</footer>
