---
// Footer of the inner pages. Same columns and legal row as the home page's footer
// (src/components/landing/LandingFooter.astro).
const year = new Date().getFullYear();

const columns = [
  { title: 'Agentes', links: [{ name: 'Invoice Cat', href: '/#facturas' }, { name: 'Tender Cat', href: '/#licitaciones' }, { name: 'Agentes', href: '/#agentes' }] },
  { title: 'Portal', links: [{ name: 'Portal', href: '/#portal' }, { name: 'Equipo', href: '/#equipo' }] },
  { title: 'Ayuda', links: [{ name: 'Preguntas', href: '/#preguntas' }, { name: 'Contacto', href: '/contacto' }] },
  { title: 'Legal', links: [{ name: 'Privacidad', href: '/privacidad' }, { name: 'Términos', href: '/terminos' }] },
];
---

<footer class="bg-white border-t border-[#111816]/10 text-[#111816]">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-0 lg:w-[calc(100%-160px)] py-16">
    <div class="grid grid-cols-2 lg:grid-cols-12 gap-x-6 gap-y-10">
      <div class="col-span-2 lg:col-span-4 space-y-4">
        <a href="/" class="inline-flex items-center gap-2">
          <img src="/assets/landing/meowlab-mark.png" alt="" width="26" height="26" class="w-[26px] h-[26px]" />
          <span class="font-title text-[22px] font-semibold tracking-tight">meow<span class="text-brand-forest">lab</span></span>
        </a>
        <p class="font-title text-xl leading-snug max-w-[30ch]">Agentes de IA en WhatsApp para mypes del Perú.</p>
      </div>
      {columns.map((col) => (
        <div class="lg:col-span-2">
          <h3 class="text-sm text-[#46544F] mb-3 font-sans">{col.title}</h3>
          <ul class="space-y-3 text-sm">
            {col.links.map((link) => (
              <li><a href={link.href} class="hover:text-brand-forest hover:underline underline-offset-4">{link.name}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-12 pt-6 border-t border-[#111816]/10 text-sm text-[#46544F] flex flex-wrap gap-x-4 gap-y-2">
      <span>© {year} MeowLab</span>
      <a href="/privacidad" class="hover:text-brand-forest">Privacidad</a>
      <a href="/terminos" class="hover:text-brand-forest">Términos</a>
    </div>
  </div>
</footer>
