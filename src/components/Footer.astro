---
---
<footer class="border-t border-white/10 bg-obsidian/95 pt-16 pb-12 text-slate-400 text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      <!-- Col 1: Brand with white cat speaking meow (green) lab (white) -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-2.5">
          <div class="w-10 h-10 relative flex items-center justify-center overflow-hidden rounded-xl bg-surface border border-white/10 p-1">
            <img src="/meowlab-cat.png" alt="MeowLab" class="w-full h-full object-contain filter brightness-110" />
          </div>
          <span class="font-title text-2xl font-black tracking-tight"><span class="text-neon">meow</span><span class="text-white">lab</span></span>
        </a>
        <p class="text-slate-400 text-xs leading-relaxed max-w-sm">
          Agencia líder de Agentes de IA en WhatsApp. Soluciones dedicadas para empresas y micro-SaaS de facturación, ventas y soporte en tiempo real.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <span class="w-2.5 h-2.5 rounded-full bg-neon animate-pulse"></span>
          <span class="text-xs font-title font-bold text-neon">Sistemas Operativos 99.99%</span>
        </div>
      </div>

      <!-- Col 2: Agentes -->
      <div class="space-y-3">
        <h4 class="font-title font-bold text-white text-sm">Agentes</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/servicios#billcat" class="hover:text-neon transition-colors">BillCat (Facturador)</a></li>
          <li><a href="/agentes#huntercat" class="hover:text-neon transition-colors">HunterCat (Leads SDR)</a></li>
          <li><a href="/dedicado" class="hover:text-neon transition-colors">NexusCat (ERP Dedicado)</a></li>
          <li><a href="/servicios#pawscollect" class="hover:text-neon transition-colors">PawsCollect (Cobranzas)</a></li>
          <li><a href="/agentes#whiskercare" class="hover:text-neon transition-colors">WhiskerCare (Soporte)</a></li>
        </ul>
      </div>

      <!-- Col 3: Soluciones -->
      <div class="space-y-3">
        <h4 class="font-title font-bold text-white text-sm">Soluciones</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/dedicado" class="hover:text-neon transition-colors">Agentes Dedicados</a></li>
          <li><a href="/servicios" class="hover:text-neon transition-colors">Servicios Micro-SaaS</a></li>
          <li><a href="/dedicado#seguridad" class="hover:text-neon transition-colors">Seguridad & VPC</a></li>
          <li><a href="/agentes" class="hover:text-neon transition-colors">Catálogo de Roles</a></li>
        </ul>
      </div>

      <!-- Col 4: Contacto & VPS -->
      <div class="space-y-3">
        <h4 class="font-title font-bold text-white text-sm">Despliegue & Soporte</h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/contacto" class="hover:text-neon transition-colors">Contacto Comercial</a></li>
          <li><a href="https://github.com/DiogoFabricioAG/meowlab" target="_blank" class="hover:text-neon transition-colors">GitHub Repository</a></li>
          <li><span class="text-slate-500">Deploy: VPS / Docker Ready</span></li>
          <li><span class="text-slate-500">Engine: Astro + MeowCore</span></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© 2026 MeowLab. Todos los derechos reservados. Hecho con Astro y amor felino 🐱⚡</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-neon">Términos de Servicio</a>
        <a href="#" class="hover:text-neon">Política de Privacidad</a>
        <a href="#" class="hover:text-neon">Seguridad</a>
      </div>
    </div>
  </div>
</footer>
