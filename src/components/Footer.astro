---
import MeowLogo from './ui/MeowLogo.astro';
import TablerIcon from './ui/TablerIcon.astro';

const currentYear = new Date().getFullYear();

const assistantLinks = [
  { name: 'Buscador de Licitaciones', href: '/#agentes' },
  { name: 'Facturación Electrónica SUNAT', href: '/#agentes' },
  { name: 'Creador de Cotizaciones en PDF', href: '/#agentes' },
  { name: 'Consultas de Almacén y Stock', href: '/#agentes' },
  { name: 'Gestor de Cobranzas', href: '/#agentes' },
  { name: 'Atención a Clientes 24/7', href: '/#agentes' },
];

const platformLinks = [
  { name: 'Portal web (app.meowlab.tech)', href: 'https://app.meowlab.tech' },
  { name: 'Equipo de agentes', href: '/#equipo' },
  { name: 'Casos de uso', href: '/#agentes' },
  { name: 'Asistente personalizado', href: '/contacto' },
  { name: 'Conexión a Excel y Sheets', href: '/#agentes' },
  { name: 'Seguridad y Privacidad', href: '/privacidad' },
];

const companyLinks = [
  { name: 'Iniciar sesión en la plataforma', href: 'https://app.meowlab.tech' },
  { name: 'Preguntas frecuentes', href: '/#faq' },
  { name: 'Contacto y WhatsApp', href: '/contacto' },
  { name: 'Términos del servicio', href: '/terminos' },
];
---

<footer class="bg-[#EBF1EE] pt-16 pb-12 md:pt-20 md:pb-16 text-[#2D3A35]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Main Multi-Column Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 pb-12">
      
      <!-- Column 1: Brand, Value Proposition & WhatsApp Status (Span 5) -->
      <div class="lg:col-span-5 space-y-5">
        <a href="/" class="inline-block focus:outline-none focus:ring-2 focus:ring-brand-forest rounded-xl">
          <MeowLogo size="md" />
        </a>

        <p class="text-sm text-[#2D3A35] leading-relaxed max-w-sm">
          Tus agentes inteligentes en WhatsApp para hacer avanzar tu negocio. Diseñado para pymes y operaciones reales: ventas, comprobantes SUNAT y compras públicas sin enredos técnicos.
        </p>

        <!-- Live Status Indicator (Static Dot) -->
        <div class="inline-flex items-center gap-2 bg-white px-3.5 py-2 rounded-xl text-sm font-semibold text-[#111816]">
          <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
          <span>Sistemas operativos en WhatsApp</span>
        </div>

      </div>

      <!-- Column 2: Agentes (Span 3) -->
      <div class="lg:col-span-3 space-y-4">
        <h3 class="text-base font-bold text-[#111816] font-title">
          Agentes para tu negocio
        </h3>
        <ul class="space-y-2.5 text-sm">
          {assistantLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-brand-forest transition-colors inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 3: Plataforma (Span 2) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-base font-bold text-[#111816] font-title">
          Plataforma
        </h3>
        <ul class="space-y-2.5 text-sm">
          {platformLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-brand-forest transition-colors inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Column 4: Contacto & Acceso (Span 2) -->
      <div class="lg:col-span-2 space-y-4">
        <h3 class="text-base font-bold text-[#111816] font-title">
          Contacto
        </h3>
        <ul class="space-y-2.5 text-sm">
          {companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-brand-forest transition-colors inline-block"
              >
                {link.name}
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-2 text-sm text-[#46544F]">
          <p class="font-medium text-[#111816]">Lima, Perú</p>
          <p class="text-sm mt-0.5">Operaciones para todo el país</p>
        </div>
      </div>

    </div>

    <!-- Trust & Security Ribbon -->
    <div class="py-8 grid grid-cols-1 sm:grid-cols-3 gap-6 text-sm text-[#2D3A35]">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-white flex items-center justify-center text-brand-forest shrink-0">
          <TablerIcon name="brand-whatsapp" size={17} className="text-[#25D366]" strokeWidth={2} />
        </div>
        <div>
          <span class="font-bold text-[#111816] block">100% en WhatsApp</span>
          <span class="text-[#46544F]">Sin instalar apps ni programas nuevos</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-white flex items-center justify-center text-brand-forest shrink-0">
          <TablerIcon name="receipt-tax" size={17} strokeWidth={2} />
        </div>
        <div>
          <span class="font-bold text-[#111816] block">Validez oficial SUNAT</span>
          <span class="text-[#46544F]">Comprobantes legales con XML y PDF</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-xl bg-white flex items-center justify-center text-brand-forest shrink-0">
          <TablerIcon name="check" size={17} strokeWidth={2.2} />
        </div>
        <div>
          <span class="font-bold text-[#111816] block">Privacidad garantizada</span>
          <span class="text-[#46544F]">Tus datos seguros y cifrados de extremo a extremo</span>
        </div>
      </div>
    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-[#46544F]">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <p>© {currentYear} MeowLab. Todos los derechos reservados.</p>
        <span class="hidden sm:inline text-[#46544F]">•</span>
        <p>Hecho en Perú para hacer avanzar a tu empresa.</p>
      </div>

      <div class="flex items-center gap-6">
        <a href="/terminos" class="hover:text-brand-forest transition-colors">Términos</a>
        <a href="/privacidad" class="hover:text-brand-forest transition-colors">Privacidad</a>
        <a href="/contacto" class="hover:text-brand-forest transition-colors">Libro de Reclamaciones</a>
      </div>
    </div>

  </div>
</footer>
