---
import TablerIcon from './ui/TablerIcon.astro';
import WhatsAppChatRuntime from './WhatsAppChatRuntime.astro';
---

<section class="relative pt-4 pb-14 md:pt-8 md:pb-20 overflow-hidden bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <WhatsAppChatRuntime>
      <!-- Main Headline -->
      <h1 class="text-[32px] sm:text-5xl lg:text-[52px] xl:text-[56px] font-bold text-content-main tracking-tight leading-[1.06] text-balance">
        Opera tu empresa por <span class="whitespace-nowrap"><TablerIcon name="brand-whatsapp" size={44} strokeWidth={2.2} className="inline-block w-[0.86em] h-[0.86em] text-[#25D366] shrink-0 align-[-0.08em] mr-1" />WhatsApp</span>
      </h1>

      <!-- Secondary Subtitle -->
      <p class="text-base sm:text-lg text-[#2D3A35] leading-relaxed font-normal max-w-[54ch]">
        Tus agentes de IA cierran ventas, emiten facturas electrónicas ante SUNAT y monitorean licitaciones del Estado desde tu chat de siempre, sin instalar programas.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
        <a
          href="https://app.meowlab.tech"
          class="btn-primary px-5 py-3.5 rounded-xl text-base font-semibold whitespace-nowrap flex items-center justify-center gap-2"
        >
          <span>Ingresar a la plataforma</span>
          <TablerIcon name="arrow-right" size={18} strokeWidth={2.2} className="text-white" />
        </a>
        <a
          href="#agentes"
          class="btn-secondary px-5 py-3.5 rounded-xl text-base font-semibold whitespace-nowrap text-center"
        >
          <span>Ver agentes y casos</span>
        </a>
      </div>

      <!-- Scannable Trust Checklist (Unboxed) -->
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-2 text-sm text-[#2D3A35] font-medium">
        <li class="inline-flex items-center gap-1.5">
          <TablerIcon name="check" size={16} strokeWidth={2.2} className="text-brand-forest shrink-0" />
          <span>Facturación SUNAT</span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <TablerIcon name="check" size={16} strokeWidth={2.2} className="text-brand-forest shrink-0" />
          <span>Control de caja</span>
        </li>
        <li class="inline-flex items-center gap-1.5">
          <TablerIcon name="check" size={16} strokeWidth={2.2} className="text-brand-forest shrink-0" />
          <span>Citas y agenda</span>
        </li>
      </ul>

    </WhatsAppChatRuntime>

  </div>
</section>
