// Secciones: Casos de uso interactivos con simulación de chat + Flujo INPUT / OUTPUT.

import TablerIcon from './ui/TablerIcon.astro';
import {
  ArrowRight,
  ArrowUpRight,
  ArrowLeftRight,
  Check,
  CheckCheck,
  FileText,
  FileCheck,
  FileSpreadsheet,
  Mic,
  Camera,
  Code,
  ShieldCheck,
  Clock,
  Search,
  Bell,
  User,
  MapPin,
  Receipt,
  MessageSquare,
  Send,
  Play,
  X
} from '@lucide/astro';

const agentsData = [
