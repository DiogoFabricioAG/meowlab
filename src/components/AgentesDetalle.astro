---

<section class="py-20 md:py-28 bg-[#FAFBF9] border-y border-surface-border" id="agentes">
  <meowlab-detail>
    <div class="md-wrap">
      <div class="md-heading text-center max-w-3xl mx-auto mb-10 md:mb-14 space-y-3">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-content-main tracking-tight font-title">
          Un gato para cada trabajo
        </h2>
        <p class="md-intro text-base sm:text-lg text-content-secondary leading-relaxed font-normal max-w-2xl mx-auto">
          Explora tus agentes especializados y descubre cómo resuelven las tareas operativas de tu empresa directamente en WhatsApp.
        </p>
      </div>

      <!-- Grid of Agent Cards (Server-rendered with Lucide icons) -->
      <div class="md-grid">
        {agentsData.map((agent) => (
          <button
            type="button"
            class="md-card"
            data-kind={agent.id}
            aria-haspopup="dialog"
            aria-label={`Ver detalles de ${agent.name}`}
          >
            <div class="md-card-top">
              <span class="md-card-pill">{agent.tag}</span>
              <span class="md-expand" aria-hidden="true">
                <ArrowUpRight class="w-4 h-4" />
              </span>
            </div>

            <h3 class="md-card-title">{agent.name}</h3>
            <p class="md-summary">{agent.summary}</p>

            <div class="md-art" aria-hidden="true">
              <img
                src={assetsData[agent.id as keyof typeof assetsData]}
                alt={agent.name}
                class="md-cat"
                width={400}
                height={400}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="md-explore">
              <span>Conocer y probar agente</span>
              <ArrowRight class="w-4 h-4 md-explore-arrow" />
            </div>
          </button>
        ))}
      </div>
    </div>

    <!-- Pre-rendered Dialog Modals for each agent with Lucide Icons and ZERO emojis -->
    <dialog id="agent-detail-dialog">
      <button type="button" class="md-close" aria-label="Cerrar detalle">
        <X class="w-5 h-5" />
      </button>

      {agentsData.map((agent, aIdx) => (
        <div
          class={`md-dialog-content ${aIdx === 0 ? 'active' : 'hidden'}`}
          data-agent-content={agent.id}
          hidden={aIdx !== 0}
          style={`--theme-primary:${agent.theme.primary};--theme-dark:${agent.theme.dark};--theme-light:${agent.theme.light};--theme-border:${agent.theme.border};--theme-glow:${agent.theme.glow};`}
        >
          <!-- Head Section -->
          <div class="md-dialog-head">
            <div>
              <span class="md-dialog-badge" style={`background:${agent.theme.badgeBg};color:${agent.theme.badgeText};`}>
                <ShieldCheck class="w-3.5 h-3.5" />
                <span>{agent.tag}</span>
              </span>
              <h2 class="md-dialog-title">{agent.name}</h2>
              <p class="md-description">{agent.description}</p>
            </div>

            <div class="md-dialog-cat-box" style={`background:${agent.theme.light};border:1px solid ${agent.theme.border};`}>
              <img
                src={assetsData[agent.id as keyof typeof assetsData]}
                alt={agent.name}
                class="md-dialog-cat"
                width={120}
                height={120}
              />
            </div>
          </div>

          <!-- 1. CASOS DE USO INTERACTIVOS -->
          <section class="md-section-block">
            <div class="md-section-title-wrap">
              <h3 class="md-section-title">
                <MessageSquare class="w-4 h-4" style={`color:${agent.theme.primary};`} />
                <span>Casos de uso interactivos</span>
              </h3>
              <span class="md-section-subtitle">Explora cómo interactúa el agente directamente en WhatsApp</span>
            </div>

            <div class="md-cases-box">
              <!-- Tabs -->
              <div class="md-case-tabs" role="tablist" aria-label={`Casos de uso de ${agent.name}`}>
                {agent.useCases.map((uc, uIdx) => (
                  <button
                    type="button"
                    role="tab"
                    id={`tab-${agent.id}-${uIdx}`}
                    class={`md-case-tab ${uIdx === 0 ? 'active' : ''}`}
                    data-tab-index={uIdx}
                    aria-selected={uIdx === 0 ? 'true' : 'false'}
                    aria-controls={`panel-${agent.id}-${uIdx}`}
                  >
                    {uc.icon === 'mic' && <Mic class="w-4 h-4" />}
                    {uc.icon === 'clock' && <Clock class="w-4 h-4" />}
                    {uc.icon === 'file' && <FileText class="w-4 h-4" />}
                    {uc.icon === 'bell' && <Bell class="w-4 h-4" />}
                    {uc.icon === 'message' && <MessageSquare class="w-4 h-4" />}
                    {uc.icon === 'search' && <Search class="w-4 h-4" />}
                    <span>{uc.title}</span>
                  </button>
                ))}
              </div>

              <!-- Case Panels -->
              {agent.useCases.map((uc, uIdx) => (
                <div
                  id={`panel-${agent.id}-${uIdx}`}
                  role="tabpanel"
                  aria-labelledby={`tab-${agent.id}-${uIdx}`}
                  class={`md-case-view ${uIdx === 0 ? 'active' : 'hidden'}`}
                  data-case-panel={uIdx}
                  hidden={uIdx !== 0}
                >
                  <!-- Left: WhatsApp Simulation -->
                  <div class="md-mini-chat">
                    {uc.dialogue.userType === 'audio' ? (
                      <div class="md-chat-bubble user audio">
                        <div class="md-audio-row">
                          <div class="md-audio-play">
                            <Play class="w-3.5 h-3.5 fill-current ml-0.5" />
                          </div>
                          <div class="md-audio-waves" aria-hidden="true">
                            <span style="height: 35%;"></span>
                            <span style="height: 65%;"></span>
                            <span style="height: 40%;"></span>
                            <span style="height: 90%;"></span>
                            <span style="height: 55%;"></span>
                            <span style="height: 75%;"></span>
                            <span style="height: 100%;"></span>
                            <span style="height: 60%;"></span>
                            <span style="height: 80%;"></span>
                            <span style="height: 45%;"></span>
                            <span style="height: 70%;"></span>
                            <span style="height: 30%;"></span>
                          </div>
                          <span class="md-audio-time">{uc.dialogue.audioDuration || '0:08'}</span>
                          <Mic class="w-3.5 h-3.5 text-[#25D366] shrink-0" />
                        </div>
                        <p class="md-audio-transcript">
                          "{uc.dialogue.userMessage}"
                        </p>
                        <div class="md-chat-meta">
                          <span>10:42 a. m.</span>
                          <CheckCheck class="w-3.5 h-3.5 text-[#53bdeb]" />
                        </div>
                      </div>
                    ) : (
                      <div class="md-chat-bubble user">
                        <p>{uc.dialogue.userMessage}</p>
                        <div class="md-chat-meta">
                          <span>10:42 a. m.</span>
                          <CheckCheck class="w-3.5 h-3.5 text-[#53bdeb]" />
                        </div>
                      </div>
                    )}

                    <div class="md-chat-status">
                      <ShieldCheck class="w-3.5 h-3.5 shrink-0" />
                      <span>{uc.dialogue.agentStatus}</span>
                    </div>

                    <div class="md-chat-bubble agent">
                      <p>{uc.dialogue.agentReply}</p>

                      <div class="md-chat-card">
                        <div class="md-chat-card-top">
                          <FileText class="w-4 h-4 shrink-0 text-slate-700" />
                          <span class="md-chat-card-title">{uc.dialogue.card.title}</span>
                        </div>
                        <div class="md-chat-card-sub">{uc.dialogue.card.client}</div>
                        <div class="md-chat-card-total">
                          <span>{uc.dialogue.card.total}</span>
                          <span class="md-chat-card-badge">
                            <CheckCheck class="w-3.5 h-3.5 inline-block -mt-0.5" /> {uc.dialogue.card.status}
                          </span>
                        </div>
                      </div>

                      <div class="md-chat-meta agent-meta">
                        <span>10:42 a. m.</span>
                      </div>
                    </div>
                  </div>

                  <!-- Right: Case Explanation & Direct WhatsApp Action -->
                  <div class="md-case-details">
                    <div>
                      <span class="md-case-badge">{uc.badge}</span>
                      <h4 class="md-case-title">{uc.title}</h4>
                      <p class="md-case-summary">{uc.summary}</p>

                      <ul class="md-case-steps">
                        {uc.steps.map((step, sIdx) => (
                          <li>
                            <span class="md-step-num">{sIdx + 1}</span>
                            <span>{step}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <a
                      href={`https://wa.me/51923790280?text=${encodeURIComponent(uc.whatsappPrompt)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="md-cta-btn"
                    >
                      <Send class="w-4 h-4" />
                      <span>Probar este caso por WhatsApp</span>
                      <ArrowRight class="w-4 h-4" />
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- 2. FLUJO INPUT / OUTPUT -->
          <section class="md-section-block">
            <div class="md-section-title-wrap">
              <h3 class="md-section-title">
                <ArrowLeftRight class="w-4 h-4" style={`color:${agent.theme.primary};`} />
                <span>Flujo de Operación: INPUT / OUTPUT</span>
              </h3>
              <span class="md-section-subtitle">Qué recibe el agente y qué documentos oficiales te entrega</span>
            </div>

            <div class="md-io-wrapper">
              <div class="md-io-grid">
                <!-- INPUT Column -->
                <div class="md-io-column">
                  <div class="md-io-col-title">
                    <span class="md-io-badge in">INPUT</span>
                    <span>{agent.io.inputTitle}</span>
                  </div>
                  <ul class="md-io-items">
                    {agent.io.inputs.map((inp) => (
                      <li class="md-io-item">
                        <span class="md-io-icon">
                          {inp.icon === 'mic' && <Mic class="w-4 h-4 text-slate-500" />}
                          {inp.icon === 'camera' && <Camera class="w-4 h-4 text-slate-500" />}
                          {inp.icon === 'user' && <User class="w-4 h-4 text-slate-500" />}
                          {inp.icon === 'map' && <MapPin class="w-4 h-4 text-slate-500" />}
                          {inp.icon === 'receipt' && <Receipt class="w-4 h-4 text-slate-500" />}
                          {inp.icon === 'message' && <MessageSquare class="w-4 h-4 text-slate-500" />}
                          {inp.icon === 'search' && <Search class="w-4 h-4 text-slate-500" />}
                          {inp.icon === 'filetext' && <FileText class="w-4 h-4 text-slate-500" />}
                        </span>
                        <div class="md-io-item-text">
                          <span class="md-io-item-title">{inp.title}</span>
                          <span class="md-io-item-desc">{inp.desc}</span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- Connector -->
                <div class="md-io-divider">
                  <div class="md-io-circle">
                    <ArrowRight class="w-4 h-4" />
                  </div>
                  <span class="md-io-divider-label">Procesa el Agente</span>
                </div>

                <!-- OUTPUT Column -->
                <div class="md-io-column">
                  <div class="md-io-col-title">
                    <span class="md-io-badge out">OUTPUT</span>
                    <span>{agent.io.outputTitle}</span>
                  </div>
                  <ul class="md-io-items">
                    {agent.io.outputs.map((out) => (
                      <li class="md-io-item">
                        <span class="md-io-icon" style={`color:${agent.theme.primary};`}>
                          {out.icon === 'filecheck' && <FileCheck class="w-4 h-4" />}
                          {out.icon === 'filetext' && <FileText class="w-4 h-4" />}
                          {out.icon === 'code' && <Code class="w-4 h-4" />}
                          {out.icon === 'send' && <Send class="w-4 h-4" />}
                          {out.icon === 'bell' && <Bell class="w-4 h-4" />}
                          {out.icon === 'clock' && <Clock class="w-4 h-4" />}
                          {out.icon === 'check' && <CheckCheck class="w-4 h-4" />}
                          {out.icon === 'spreadsheet' && <FileSpreadsheet class="w-4 h-4" />}
                        </span>
                        <div class="md-io-item-text">
                          <span class="md-io-item-title">{out.title}</span>
                          <span class="md-io-item-desc">{out.desc}</span>
                        </div>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="md-io-footer">
                <ShieldCheck class="w-4 h-4 shrink-0" style={`color:${agent.theme.primary};`} />
                <span>{agent.io.badge}</span>
              </div>
            </div>
          </section>

          <!-- Footer WhatsApp CTA -->
          <div class="md-dialog-footer">
            <a
              href={agent.cta.href}
              target="_blank"
              rel="noopener noreferrer"
              class="md-cta-btn"
            >
              <TablerIcon name="brand-whatsapp" size={18} className="text-[#25D366]" strokeWidth={2.2} />
              <span>{agent.cta.label}</span>
              <ArrowRight class="w-4 h-4" />
            </a>

            <span class="md-cta-trust">
              <Check class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Sin instalaciones · Activación en menos de 24 horas</span>
            </span>
          </div>
        </div>
      ))}
    </dialog>
  </meowlab-detail>
</section>

