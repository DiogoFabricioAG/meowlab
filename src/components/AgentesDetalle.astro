<script>
  (() => {
    if (customElements.get('meowlab-detail')) return;

    customElements.define('meowlab-detail', class extends HTMLElement {
      private ready = false;
      private abort?: AbortController;
      private dialog!: HTMLDialogElement;
      private origin?: HTMLElement;
      private animation?: Animation;
      private closing = false;
      private oldOverflow = '';

      connectedCallback() {
        requestAnimationFrame(() => this.setup());
      }

      setup() {
        if (!this.isConnected) return;
        this.abort?.abort();
        this.abort = new AbortController();
        const opts = { signal: this.abort.signal };

        this.dialog = this.querySelector('#agent-detail-dialog') as HTMLDialogElement;
        if (!this.dialog) return;

        const cards = this.querySelectorAll<HTMLElement>('.md-card');
        cards.forEach((card) => {
          const kind = card.dataset.kind;
          card.addEventListener('click', (e) => {
            e.preventDefault();
            if (kind) this.open(kind, card);
          }, opts);
        });

        // Close button
        const closeBtn = this.dialog.querySelector('.md-close');
        closeBtn?.addEventListener('click', (e) => {
          e.preventDefault();
          this.close();
        }, opts);

        // Backdrop click
        this.dialog.addEventListener('click', (e) => {
          if (e.target === this.dialog) {
            const r = this.dialog.getBoundingClientRect();
            if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) {
              this.close();
            }
          }
        }, opts);

        this.dialog.addEventListener('cancel', (e) => {
          e.preventDefault();
          this.close();
        }, opts);

        // Setup case tabs within each agent panel
        this.dialog.querySelectorAll<HTMLElement>('.md-dialog-content').forEach((panel) => {
          const tabs = panel.querySelectorAll<HTMLElement>('.md-case-tab');
          const views = panel.querySelectorAll<HTMLElement>('.md-case-view');

          tabs.forEach((tab) => {
            tab.addEventListener('click', (e) => {
              e.preventDefault();
              const idx = tab.dataset.tabIndex;
              if (idx === undefined) return;

              tabs.forEach((t) => {
                const isActive = t === tab;
                t.classList.toggle('active', isActive);
                t.setAttribute('aria-selected', isActive ? 'true' : 'false');
              });

              views.forEach((v) => {
                const isMatch = v.dataset.casePanel === idx;
                v.classList.toggle('active', isMatch);
                v.classList.toggle('hidden', !isMatch);
                if (isMatch) {
                  v.removeAttribute('hidden');
                  v.style.display = 'grid';
                } else {
                  v.setAttribute('hidden', '');
                  v.style.display = 'none';
                }
              });
            }, opts);
          });
        });

        this.ready = true;
      }

      open(kind: string, card: HTMLElement) {
        if (!this.dialog || this.dialog.open) return;
        this.origin = card;
        this.closing = false;

        // Show only the clicked agent's content
        const contents = this.dialog.querySelectorAll<HTMLElement>('.md-dialog-content');
        contents.forEach((c) => {
          const isSelected = c.dataset.agentContent === kind;
          c.classList.toggle('active', isSelected);
          c.classList.toggle('hidden', !isSelected);

          if (isSelected) {
            c.removeAttribute('hidden');
            c.style.display = 'block';
            c.scrollTop = 0;

            // Reset tabs to first tab inside this active agent
            const tabs = c.querySelectorAll<HTMLElement>('.md-case-tab');
            const views = c.querySelectorAll<HTMLElement>('.md-case-view');

            tabs.forEach((tab, tIdx) => {
              const isFirst = tIdx === 0;
              tab.classList.toggle('active', isFirst);
              tab.setAttribute('aria-selected', isFirst ? 'true' : 'false');
            });

            views.forEach((view, vIdx) => {
              const isFirst = vIdx === 0;
              view.classList.toggle('active', isFirst);
              view.classList.toggle('hidden', !isFirst);
              if (isFirst) {
                view.removeAttribute('hidden');
                view.style.display = 'grid';
              } else {
                view.setAttribute('hidden', '');
                view.style.display = 'none';
              }
            });
          } else {
            c.setAttribute('hidden', '');
            c.style.display = 'none';
          }
        });

        this.dialog.showModal();
        this.dialog.scrollTop = 0;
        this.oldOverflow = document.documentElement.style.overflow;
        document.documentElement.style.overflow = 'hidden';

        const closeBtn = this.dialog.querySelector('.md-close') as HTMLElement;
        closeBtn?.focus({ preventScroll: true });

        // Smooth FLIP expand animation from card to modal
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const a = card.getBoundingClientRect();
          const b = this.dialog.getBoundingClientRect();
          this.animation = this.dialog.animate([
            {
              transform: `translate(${a.left + a.width / 2 - b.left - b.width / 2}px, ${a.top + a.height / 2 - b.top - b.height / 2}px) scale(${a.width / b.width}, ${a.height / b.height})`,
              opacity: 0.3
            },
            {
              transform: 'none',
              opacity: 1
            }
          ], {
            duration: 390,
            easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)'
          });
        }
      }

      async close() {
        if (!this.dialog || !this.dialog.open || this.closing) return;
        this.closing = true;
        this.animation?.cancel();

        // Smooth exit animation
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
          try {
            await this.dialog.animate([
              { opacity: 1, transform: 'translateY(0) scale(1)' },
              { opacity: 0, transform: 'translateY(14px) scale(0.97)' }
            ], {
              duration: 150,
              easing: 'ease-in',
              fill: 'forwards'
            }).finished;
          } catch {}
        }

        this.dialog.close();
        this.dialog.getAnimations().forEach((a) => a.cancel());
        document.documentElement.style.overflow = this.oldOverflow || '';
        this.origin?.focus({ preventScroll: true });
        this.closing = false;
      }

      disconnectedCallback() {
        this.abort?.abort();
        if (this.dialog?.open) {
          this.dialog.close();
          document.documentElement.style.overflow = '';
        }
        this.ready = false;
      }
    });

    document.addEventListener('astro:page-load', () => {
      const el = document.querySelector('meowlab-detail') as any;
      if (el && typeof el.setup === 'function') {
        el.setup();
      }
    });
  })();
</script>
