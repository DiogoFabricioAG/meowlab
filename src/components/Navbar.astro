---
// Header of the inner pages (contacto, privacidad, terminos). It mirrors the home page's nav
// (src/components/landing/LandingNav.astro): the cat mark, four words in the middle, one main action.
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'Agentes', href: '/#agentes' },
  { name: 'Portal', href: '/#portal' },
  { name: 'Equipo', href: '/#equipo' },
  { name: 'Preguntas', href: '/#preguntas' },
];
const portal = 'https://app.meowlab.tech';
---

<header class="sticky top-0 z-50 bg-white border-b border-[#111816]/10" id="main-header" data-path={currentPath}>
  <div class="max-w-[1280px] mx-auto px-6 md:px-12 lg:px-0 lg:w-[calc(100%-160px)]">
    <div class="relative flex items-center justify-between h-[72px]">
      <a href="/" class="flex items-center gap-2 rounded-lg focus-visible:outline-2 focus-visible:outline-brand-forest">
        <img src="/assets/landing/meowlab-mark.png" alt="" width="26" height="26" class="w-[26px] h-[26px]" />
        <span class="font-title text-[22px] font-semibold tracking-tight text-[#111816]">meow<span class="text-brand-forest">lab</span></span>
      </a>

      <nav class="hidden md:flex items-center gap-8 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2" aria-label="Principal">
        {navLinks.map((link) => (
          <a href={link.href} class="text-[15px] text-[#111816] hover:text-brand-forest underline-offset-4 hover:underline">
            {link.name}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a href={portal} class="inline-flex items-center h-11 px-5 rounded-lg bg-brand-forest text-white text-[15px] hover:bg-brand-forest-hover transition-colors">
          Entrar al portal
        </a>
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden inline-grid place-items-center w-11 h-11 rounded-lg bg-[#111816]/5 text-[#111816]"
          aria-label="Menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-[#111816]/10 px-6 pb-4">
    {navLinks.map((link) => (
      <a href={link.href} class="mobile-nav-link flex items-center h-14 border-b border-[#111816]/10 text-base text-[#111816]">
        {link.name}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      menu.classList.toggle('hidden');
    });
    document.querySelectorAll('.mobile-nav-link').forEach((link) =>
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }),
    );
  }
</script>
