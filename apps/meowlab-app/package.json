{
  "name": "meowlab-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "db:migrate:local": "wrangler d1 migrations apply meowlab-app-dev --local",
    "build:node": "vite build && esbuild server/node.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.mjs",
    "start:node": "node build/server.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "better-auth": "1.7",
    "hono": "4.13",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "react": "19.3",
    "react-dom": "19.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.160.1"
  }
}
