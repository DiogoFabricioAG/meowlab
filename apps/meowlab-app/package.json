{
  "name": "meowlab-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply meowlab-app-dev --local",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "1.7",
    "hono": "4.13",
    "kysely": "^0.29.8",
    "react": "19.3",
    "react-dom": "19.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.160.1"
  }
}
