# Local-only values. Copy this file to .dev.vars and replace the placeholders.
WHATSAPP_VERIFY_TOKEN="replace-with-a-local-verification-token"
META_APP_SECRET="replace-with-your-meta-app-secret"
META_ACCESS_TOKEN="replace-with-a-local-access-token"
META_GRAPH_API_VERSION="replace-with-the-version-from-meta-api-setup"
WHATSAPP_PHONE_NUMBER_ID="replace-with-your-whatsapp-phone-number-id"
GROQ_API_KEY="replace-with-your-local-groq-api-key"
GROQ_QUOTES_MODEL="openai/gpt-oss-20b"
GROQ_TRANSCRIPTION_MODEL="whisper-large-v3-turbo"
OPENAI_API_KEY="replace-with-your-enterprise-model-api-key"
ENTERPRISE_AI_BASE_URL="https://api.openai.com/v1"
ENTERPRISE_AI_MODEL="gpt-5.6-luna"
ENTERPRISE_AI_REASONING_EFFORT="high"
NEON_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
VPS_BRIDGE_API_URL="https://your-vps-domain.example/internal/manolo"
VPS_BRIDGE_HMAC_SECRET="replace-with-the-same-hmac-secret-used-by-the-vps"
STORE_DESIGN_API_URL="http://localhost:3000/api/internal/store-design"
STORE_DESIGN_API_SECRET="replace-with-the-same-private-secret-used-by-the-store"
